import Mathlib.RepresentationTheory.Homological.GroupCohomology.Hilbert90
import Mathlib.Tactic

/-! Finite-level norm descent for nontrivial tame characters. -/
namespace TunnellNormDescent

variable {A B k G : Type*} [AddCommGroup A] [AddCommGroup B] [Field k] [CommGroup G]
  [DistribMulAction G A] [DistribMulAction G B]

/-- A nontrivial-character functional on a cyclic upper level descends along the norm to
    the whole lower multiplicative group, written additively here. Hilbert 90 controls the
    kernel and local reciprocity makes the norm quotient trivial under the tame action. -/
theorem eigencharacter_descends (N:A→+B) (σ:A→+A) (χ:G→*kˣ) (δ:G) (hχ : (χ δ:k)≠1)
    (hN : ∀ (g:G) (x:A), N (g • x)=g • N x)
    (h90 : ∀ x : A, N x=0 → ∃ y, x=y-σ y)
    (hrange : ∀ x:B, ∃ y:A, N y=δ • x-x)
    (α : A→+k) (hσ : ∀ x, α (σ x)=α x) (hα : ∀ (g:G) (x:A), α (g•x)=(χ g:k)*α x) :
    ∃ β : B→+k, (∀ x:A, β (N x)=α x) ∧ ∀ (g:G) (x:B), β (g•x)=(χ g:k)*β x := by
  classical
  have hker (x y:A) (h : N x=N y) : α x=α y := by
    have hxy : N (x-y)=0 := by rw [map_sub,h,sub_self]
    obtain ⟨t,he⟩ := h90 _ hxy
    apply sub_eq_zero.mp
    rw [←map_sub,he,map_sub,hσ,sub_self]
  let s (x:B) := (hrange x).choose
  have hs (x:B) : N (s x)=δ • x-x := (hrange x).choose_spec
  let b (x:B) := α (s x)/((χ δ:k)-1)
  have hden : (χ δ:k)-1≠0 := sub_ne_zero.mpr hχ
  let β : B→+k := {
    toFun := b
    map_zero' := by
      have he : α (s 0)=α 0 := hker _ _ (by simp [hs])
      simp [b,he]
    map_add' x y := by
      have he : α (s (x+y))=α (s x+s y) := hker _ _ (by rw [hs,map_add,hs,hs,smul_add]; abel)
      simp only [b,he,map_add,add_div] }
  refine ⟨β,?_,?_⟩
  · intro x
    have he : α (s (N x))=α (δ • x-x) := hker _ _ (by rw [hs,map_sub,hN])
    change α (s (N x))/((χ δ:k)-1)=α x
    rw [he,map_sub,hα,div_eq_iff hden]; ring
  · intro g x
    have he : α (s (g • x))=α (g • s x) := hker _ _ (by rw [hs,hN,hs,smul_sub,←mul_smul,mul_comm,mul_smul])
    change α (s (g•x))/((χ δ:k)-1)=(χ g:k)*(α (s x)/((χ δ:k)-1))
    rw [he,hα,mul_div_assoc]

/-- The natural norm on a cyclic extension has kernel generated by the displacement of a
    cyclic generator, in exactly the orientation used in the finite-level descent. -/
lemma norm_hilbert90 {F L : Type} [Field F] [Field L] [Algebra F L] [FiniteDimensional F L]
    [IsGalois F L] [IsCyclic (L≃ₐ[F]L)] (σ : L≃ₐ[F]L) (hσ : ∀ g, g∈Subgroup.zpowers σ)
    (x : Lˣ) (hx : Units.map (Algebra.norm F : L→*F) x=1) :
    ∃ y : Lˣ, x=y / Units.map σ.toMonoidHom y := by
  have hnorm : Algebra.norm F (x:L) = 1 := congrArg Units.val hx
  obtain ⟨y,hy⟩ := groupCohomology.exists_div_of_norm_eq_one hσ hnorm
  refine ⟨y,Units.ext ?_⟩
  rw [Units.val_div_eq_div_val,Units.coe_map]
  change (x:L)=(y:L)/σ (y:L)
  exact hy.symm

end TunnellNormDescent
