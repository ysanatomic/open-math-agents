    Nonempty ((K ⊗[ℚ] D) ≃ₐ[D] AdeleRing (𝓞 D) D) := by
  exact ⟨intermediateRelativeAdeleBaseChangeAlgEquiv ℚ D⟩
end TunnellAdeleScalarExtension
