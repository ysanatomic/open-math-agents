import TunnellLocalCMCoordDegree
import TunnellAdicGenerators
import TunnellCMTorsionField
import TunnellCyclicKummerCharacter

/-! Normality of the field generated by a division lift together with the primary torsion field. -/
namespace TunnellKummerCompositum
open WeierstrassCurve WeierstrassCurve.Affine TunnellKummer TunnellCMTorsionField
open scoped Classical IsMulCommutative
noncomputable section
variable {F B:Type} [Field F] [Field B] [Algebra F B] [Normal F B] [DecidableEq F] [DecidableEq B]
variable (W:WeierstrassCurve F) (φ:CurvePoints W B→+CurvePoints W B)

theorem rational_mono {A D:IntermediateField F B} (h:A≤D) : rationalPoints W A≤rationalPoints W D := by
  intro P hP
  cases P with
  | zero=>exact (rationalPoints W D).zero_mem
  | some x y hh=>
    have hp := (rationalPoints_some W hh).mp hP
    exact (rationalPoints_some W hh).mpr ⟨h hp.1,h hp.2⟩

theorem normal (D:IntermediateField F B) [Normal F D] (Q:CurvePoints W B)
    (hφ:∀ σ:Gal(B/F),∀X,φ (act W σ X)=act W σ (φ X))
    (hP:∀ σ:Gal(B/F),act W σ (φ Q)=φ Q)
    (ht:φ.ker≤rationalPoints W D) : Normal F ↥(D⊔coordField W Q) := by
  let N:=D⊔coordField W Q
  have hQ:Q∈rationalPoints W N:=rational_mono W le_sup_right (point_rational W Q)
  have hker:φ.ker≤rationalPoints W N:=ht.trans (rational_mono W le_sup_left)
  apply IntermediateField.normal_iff_forall_map_le'.mpr
  intro σ
  rw [IntermediateField.map_sup]
  apply sup_le
  · exact ((IntermediateField.normal_iff_forall_map_le'.mp ‹Normal F D›) σ).trans le_sup_left
  · rw [TunnellLocalCMCoordDegree.coord_map]
    apply TunnellLocalCMCoordDegree.coord_le
    have hm:=hker (translation_mem W φ Q hφ hP σ)
    change act W σ Q∈rationalPoints W N
    simpa using (rationalPoints W N).add_mem hm hQ

theorem relative_abelian {K T L:Type} [Field K] [Field T] [Field L] [Algebra K T] [Algebra K L]
    [Algebra T L] [IsScalarTower K T L] [FiniteDimensional T L] [IsGalois K L] [DecidableEq K] [DecidableEq L]
    (W:WeierstrassCurve K) (φ:CurvePoints W L→+CurvePoints W L) (Q S:CurvePoints W L)
    (hφ:∀σ:Gal(L/K),∀X,φ (act W σ X)=act W σ (φ X)) (hP:∀σ:Gal(L/K),act W σ (φ Q)=φ Q)
    (hgen:∀X,φ X=0 → X∈AddSubgroup.zmultiples S) (hfix:∀σ:Gal(L/T),act W (σ.restrictScalars K) S=S)
    {x y:L} (hq:(W.baseChange L).toAffine.Nonsingular x y) (he:Q=.some x y hq) (hxy:IntermediateField.adjoin T {x,y}=⊤) :
    IsAbelianGalois T L ∧ Module.finrank T L∣addOrderOf S := by
  haveI:IsGalois T L:=IsGalois.tower_top_of_isGalois K T L
  let f:=TunnellCyclicKummerCharacter.translation W φ Q S hφ hP hgen hfix
  have hf:=TunnellCyclicKummerCharacter.translation_injective W φ Q S hφ hP hgen hfix hq he hxy
  haveI:IsCyclic Gal(L/T):=isCyclic_of_injective f hf
  refine ⟨{is_comm.comm x y:=hf (by rw [f.map_mul,f.map_mul,mul_comm])},?_⟩
  rw [←IsGalois.card_aut_eq_finrank,←Nat.card_zmultiples S]
  exact Subgroup.card_dvd_of_injective (H:=Multiplicative (AddSubgroup.zmultiples S)) f hf

#print axioms normal
#print axioms relative_abelian
end
end TunnellKummerCompositum
