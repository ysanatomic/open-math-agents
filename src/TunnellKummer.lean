import FormalConjectures.Wikipedia.CongruentNumber

/-! # Division-point Kummer maps on elliptic curves -/

namespace TunnellKummer

open WeierstrassCurve

variable {F L : Type*} [Field F] [Field L] [Algebra F L]
variable (W : WeierstrassCurve F)

abbrev CurvePoints (W : WeierstrassCurve F) (L : Type*) [Field L] [Algebra F L] := (W.baseChange L).toAffine.Point

variable [DecidableEq L]

noncomputable def act (σ : (L ≃ₐ[F] L)) : (CurvePoints W L) →+ (CurvePoints W L) := Affine.Point.map (W' := W.toAffine) σ.toAlgHom

lemma act_mul (σ τ : (L ≃ₐ[F] L)) (P : (CurvePoints W L)) : act W (σ*τ) P = act W σ (act W τ P) := by
  exact (Affine.Point.map_map τ.toAlgHom σ.toAlgHom P).symm

lemma act_one (P : (CurvePoints W L)) : act W (1 : (L ≃ₐ[F] L)) P = P := by cases P <;> rfl

lemma act_inv_apply (τ : (L ≃ₐ[F] L)) (P : (CurvePoints W L)) : act W τ (act W τ⁻¹ P) = P := by
  rw [← act_mul, mul_inv_cancel, act_one]

variable (φ : (CurvePoints W L) →+ (CurvePoints W L)) (Q : (CurvePoints W L))
variable (hφ : ∀ (σ : (L ≃ₐ[F] L)) (T : (CurvePoints W L)), φ (act W σ T) = act W σ (φ T))
variable (hP : ∀ σ : (L ≃ₐ[F] L), act W σ (φ Q) = φ Q)

include hφ hP in
lemma translation_mem (σ : (L ≃ₐ[F] L)) : act W σ Q - Q ∈ φ.ker := by
  change φ (act W σ Q - Q) = 0
  rw [map_sub,hφ,hP,sub_self]

/-- Over any subgroup of field automorphisms fixing the division torsion, the Galois action
on a fiber is given by translations, which form a homomorphism into the torsion kernel. -/
noncomputable def divisionHom (H : Subgroup (L ≃ₐ[F] L))
    (ht : ∀ σ : H, ∀ T ∈ φ.ker, act W σ.val T = T) : H →* Multiplicative φ.ker where
  toFun σ := Multiplicative.ofAdd ⟨_,translation_mem W φ Q hφ hP σ.val⟩
  map_one' := by
    apply Subtype.ext
    change act W (1 : (L ≃ₐ[F] L)) Q - Q = 0
    rw [act_one, sub_self]
  map_mul' σ τ := by
    apply Subtype.ext
    change act W (σ.val*τ.val) Q - Q = (act W σ.val Q-Q)+(act W τ.val Q-Q)
    have hf := ht σ _ (translation_mem W φ Q hφ hP τ.val)
    rw [map_sub] at hf
    rw [act_mul, (sub_eq_iff_eq_add).mp hf]
    abel

include hφ hP in
/-- Equation (48) of Coates–Wiles: conjugation of a Kummer translation equals the
natural Galois action on the corresponding division point. -/
lemma translation_conjugate (σ τ : (L ≃ₐ[F] L))
    (ht : ∀ T ∈ φ.ker, act W σ T = T) :
    act W (τ*σ*τ⁻¹) Q - Q = act W τ (act W σ Q-Q) := by
  have hf := ht _ (translation_mem W φ Q hφ hP τ⁻¹)
  rw [map_sub] at hf
  have h := congrArg (act W τ) hf
  rw [map_sub,map_sub,act_inv_apply] at h
  rw [act_mul,act_mul,(sub_eq_iff_eq_add).mp h,map_sub]
  abel

lemma autos_eq_of_generate {u v : L} (hgen : IntermediateField.adjoin F {u,v} = ⊤)
    (σ τ : (L ≃ₐ[F] L)) (hu : σ u=τ u) (hv : σ v=τ v) : σ=τ := by
  ext x
  have hx : x ∈ IntermediateField.adjoin F {u,v} := hgen ▸ trivial
  induction hx using IntermediateField.adjoin_induction with
  | mem y hy => rcases hy with (rfl|ht); exact hu; obtain rfl := Set.mem_singleton_iff.mp ht; exact hv
  | algebraMap y => simp
  | add _ _ _ _ h1 h2 => simp only [map_add,h1,h2]
  | inv _ _ hh => simp only [map_inv₀,hh]
  | mul _ _ _ _ h1 h2 => simp only [map_mul,h1,h2]

/-- When the extension is generated by the two coordinates of the chosen lift, its
Kummer homomorphism is injective. -/
lemma divisionHom_injective {u v : L} (hQ : (W.baseChange L).toAffine.Nonsingular u v)
    (hgen : IntermediateField.adjoin F {u,v} = ⊤) (H : Subgroup (L ≃ₐ[F] L))
    (hP' : ∀ σ : (L ≃ₐ[F] L), act W σ (φ (Affine.Point.some u v hQ)) = φ (Affine.Point.some u v hQ))
    (ht : ∀ σ : H, ∀ T ∈ φ.ker, act W σ.val T = T) :
    Function.Injective (divisionHom W φ (Affine.Point.some u v hQ) hφ hP' H ht) := by
  intro σ τ he
  have h := congrArg (fun a : Multiplicative φ.ker => (a.toAdd:(CurvePoints W L))) he
  change act W σ.val (.some u v hQ) - _ = act W τ.val (.some u v hQ) - _ at h
  have hc := sub_left_inj.mp h
  change Affine.Point.some (σ.val u) (σ.val v) _ = Affine.Point.some (τ.val u) (τ.val v) _ at hc
  exact Subtype.ext (autos_eq_of_generate hgen _ _ (Affine.Point.some.inj hc).1 (Affine.Point.some.inj hc).2)

include hφ in
/-- If the division kernel is cyclic of order m, a Galois division field generated by
one lift is cyclic of degree dividing m. -/
theorem cyclic_degree_dvd [FiniteDimensional F L] [IsGalois F L]
    {u v : L} (hQ : (W.baseChange L).toAffine.Nonsingular u v)
    (hgen : IntermediateField.adjoin F {u,v} = ⊤)
    (hP' : ∀ σ : (L ≃ₐ[F] L), act W σ (φ (Affine.Point.some u v hQ)) = φ (Affine.Point.some u v hQ))
    (ht : ∀ σ : (L ≃ₐ[F] L), ∀ T ∈ φ.ker, act W σ T = T)
    [IsAddCyclic φ.ker] :
    IsCyclic (L ≃ₐ[F] L) ∧ Module.finrank F L ∣ Nat.card φ.ker := by
  let f := divisionHom W φ (Affine.Point.some u v hQ) hφ hP' ⊤ (fun σ => ht σ)
  let e := (Subgroup.topEquiv : (⊤ : Subgroup (L ≃ₐ[F] L)) ≃* (L ≃ₐ[F] L))
  let g := f.comp e.symm.toMonoidHom
  have hfi := divisionHom_injective W φ hφ hQ hgen ⊤ hP' (fun σ => ht σ)
  have hgi : Function.Injective g := hfi.comp e.symm.injective
  constructor
  · exact isCyclic_of_injective g hgi
  · rw [← IsGalois.card_aut_eq_finrank F L]
    exact Subgroup.card_dvd_of_injective (H := Multiplicative φ.ker) g hgi

noncomputable def rationalPoints (K : IntermediateField F L) : AddSubgroup (CurvePoints W L) :=
  (Affine.Point.map (W' := W.toAffine) K.val).range

lemma rationalPoints_some {K : IntermediateField F L} {x y : L}
    (h : (W.baseChange L).toAffine.Nonsingular x y) :
    Affine.Point.some x y h ∈ rationalPoints W K ↔ x∈K ∧ y∈K := by
  constructor
  · rintro ⟨P,hP⟩
    cases P with
    | zero => cases hP
    | some a b hq =>
      change Affine.Point.some (a:L) (b:L) _ = _ at hP
      have hc := Affine.Point.some.inj hP
      exact ⟨hc.1 ▸ a.property, hc.2 ▸ b.property⟩
  · rintro ⟨hx,hy⟩
    let a : K := ⟨x,hx⟩
    let b : K := ⟨y,hy⟩
    have h' : (W.baseChange K).toAffine.Nonsingular a b :=
      (W.toAffine.baseChange_nonsingular K.val.injective a b).mp h
    exact ⟨Affine.Point.some a b h',rfl⟩

include hφ in
/-- If a fiber lies over an F-rational point and its kernel is rational in the coordinate
field of one lift, that coordinate field is normal. -/
theorem divisionField_normal [Normal F L] {u v : L}
    (hQ : (W.baseChange L).toAffine.Nonsingular u v)
    (hP' : ∀ σ : (L ≃ₐ[F] L), act W σ (φ (Affine.Point.some u v hQ)) = φ (Affine.Point.some u v hQ))
    (ht : φ.ker ≤ rationalPoints W (IntermediateField.adjoin F {u,v})) :
    Normal F (IntermediateField.adjoin F {u,v}) := by
  let K := IntermediateField.adjoin F {u,v}
  let S := rationalPoints W K
  let R := Affine.Point.some u v hQ
  have hR : R∈S := (rationalPoints_some W hQ).mpr
    ⟨IntermediateField.subset_adjoin F _ (by simp), IntermediateField.subset_adjoin F _ (by simp)⟩
  apply IntermediateField.normal_iff_forall_map_le'.mpr
  intro σ
  have hd := ht (translation_mem W φ R hφ hP' σ)
  have hσ : act W σ R ∈ S := by simpa using S.add_mem hd hR
  have he := (rationalPoints_some W _).mp hσ
  rw [IntermediateField.adjoin_map,IntermediateField.adjoin_le_iff]
  rintro x ⟨y,hy,rfl⟩
  rcases hy with (rfl|hy)
  · exact he.1
  · obtain rfl := Set.mem_singleton_iff.mp hy
    exact he.2

#print axioms divisionField_normal
#print axioms cyclic_degree_dvd
#print axioms divisionHom_injective
#print axioms translation_conjugate

end TunnellKummer
