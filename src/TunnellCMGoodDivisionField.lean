import TunnellCMGoodInertiaAction
import Mathlib.NumberTheory.RamificationInertia.Galois
import Mathlib.NumberTheory.NumberField.Ideal.Basic

/-! The field generated by the coordinates of a prime-power division point has
trivial inertia at good primes of different residue characteristic. -/
namespace TunnellCMGoodDivisionField
open WeierstrassCurve WeierstrassCurve.Affine IsDedekindDomain IsLocalRing NumberField
open TunnellCMGoodInertiaAction TunnellKummer
open scoped NumberField
noncomputable section
variable {F N : Type*} [Field F] [Field N] [NumberField N] [Algebra F N] [DecidableEq N]
  (v : HeightOneSpectrum (𝓞 N))
local notation "O" => v.adicCompletionIntegers N
local notation "L" => v.adicCompletion N

theorem trivial_inertia (W : WeierstrassCurve F) (W₀ : WeierstrassCurve O)
    (hW : W₀.map (algebraMap O L)=(W.baseChange N).baseChange L)
    [W₀.IsElliptic] [((W.baseChange N).baseChange L).IsElliptic]
    [DecidableEq L] [DecidableEq (ResidueField O)]
    {l p : ℕ} (hl : l.Prime) (hp : p.Prime) (hne : p≠l) (hchar : (l:O)∈maximalIdeal O)
    (r : ℕ) {x y : N} (h : (W.baseChange N).toAffine.Nonsingular x y)
    (hgen : IntermediateField.adjoin F {x,y}=⊤)
    (hP : ∀ σ : N ≃ₐ[F] N, act W σ (p^r • Point.some x y h)=p^r • Point.some x y h) :
    v.asIdeal.inertia (N ≃ₐ[F] N)=⊥ := by
  apply le_antisymm _ bot_le
  intro σ hσ
  change σ=1
  have H := inertia_fixes_division v W W₀ hW σ hσ hl hp hne hchar r _ (hP σ)
  change Point.some (σ x) (σ y) _=Point.some x y h at H
  exact autos_eq_of_generate hgen σ 1 (Point.some.inj H).1 (Point.some.inj H).2

theorem unramified_of_trivial [NumberField F] [FiniteDimensional F N] [IsGalois F N]
    (u : HeightOneSpectrum (𝓞 F)) [v.asIdeal.LiesOver u.asIdeal]
    (h : v.asIdeal.inertia (N ≃ₐ[F] N)=⊥) : v.asIdeal.ramificationIdx (𝓞 F)=1 := by
  letI : IsGaloisGroup (N ≃ₐ[F] N) (𝓞 F) (𝓞 N) :=
    IsGaloisGroup.of_isFractionRing _ _ _ F N
  letI : Finite ((𝓞 F) ⧸ u.asIdeal) := Ring.HasFiniteQuotients.finiteQuotient u.ne_bot
  letI : PerfectField u.asIdeal.ResidueField := PerfectField.ofFinite
  rw [← Ideal.ramificationIdxIn_eq_ramificationIdx u.asIdeal v.asIdeal (N ≃ₐ[F] N),
      ← Ideal.card_inertia_eq_ramificationIdxIn (G := N ≃ₐ[F] N) u.asIdeal v.asIdeal]
  exact Subgroup.card_eq_one.mpr h

end
end TunnellCMGoodDivisionField
#print axioms TunnellCMGoodDivisionField.trivial_inertia
#print axioms TunnellCMGoodDivisionField.unramified_of_trivial
