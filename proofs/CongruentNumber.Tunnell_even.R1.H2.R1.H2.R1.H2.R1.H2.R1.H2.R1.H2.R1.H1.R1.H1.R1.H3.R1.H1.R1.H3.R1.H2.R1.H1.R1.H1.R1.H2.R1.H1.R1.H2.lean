namespace TunnellIdealStabilizer
open NumberField IsDedekindDomain
open scoped NumberField Pointwise
noncomputable section
variable (D N:Type) [Field D] [NumberField D] [Field N] [NumberField N]
  [Algebra D N] [FiniteDimensional D N] [IsGalois D N]
theorem cyclic (v:HeightOneSpectrum (𝓞 D)) (w:HeightOneSpectrum (𝓞 N))
    [w.asIdeal.LiesOver v.asIdeal] [Algebra.IsUnramifiedAt (𝓞 D) w.asIdeal] :
    IsCyclic (MulAction.stabilizer Gal(N/D) w.asIdeal) := by
  classical
  letI : Field ((𝓞 D) ⧸ v.asIdeal):=Ideal.Quotient.field _
  letI : Field ((𝓞 N) ⧸ w.asIdeal):=Ideal.Quotient.field _
  let G:=Gal(N/D)
  let P:=w.asIdeal
  let p:=v.asIdeal
  let H:=MulAction.stabilizer G P
  letI : Finite ((𝓞 D) ⧸ p):=v.asIdeal.finiteQuotientOfFreeOfNeBot v.ne_bot
  letI : Finite ((𝓞 N) ⧸ P):=w.asIdeal.finiteQuotientOfFreeOfNeBot w.ne_bot
  haveI : Finite p.ResidueField:=Finite.of_surjective _ p.bijective_algebraMap_quotient_residueField.surjective
  have card:Nat.card (P.inertia G)=1:=by
    rw [Ideal.card_inertia_eq_ramificationIdxIn p P,Ideal.ramificationIdxIn_eq_ramificationIdx p P G]
    exact Ideal.ramificationIdx_eq_one_of_isUnramifiedAt
  have bot:P.inertia G=⊥:=Subgroup.eq_bot_of_card_eq _ card
  let f:=Ideal.Quotient.stabilizerHom P p G
  apply isCyclic_of_injective f
  apply f.ker_eq_bot_iff.mp
  rw [Ideal.Quotient.ker_stabilizerHom]
  change (P.inertia G).subgroupOf H=⊥
  rw [bot,Subgroup.bot_subgroupOf]
end
end TunnellIdealStabilizer
namespace TunnellPrimeInertModel
open NumberField IsDedekindDomain
open scoped NumberField

def PrimePlaces : Prop :=
  ∀ (D N:Type) [Field D] [NumberField D] [Field N] [NumberField N]
    [Algebra D N] [FiniteDimensional D N] [IsGalois D N],
    (Module.finrank D N).Prime →
    {v:HeightOneSpectrum (𝓞 D) | Nat.card (v.asIdeal.primesOver (𝓞 N))=1}.Infinite

end TunnellPrimeInertModel

namespace TunnellFrobeniusGroups
open NumberField IsDedekindDomain AlgebraicNumberTheory.Valuations
open scoped NumberField Classical Pointwise
noncomputable section
private theorem stabilizes_of_cyclic {G X:Type} [Group G] [Finite G] [MulAction G X] (x:X)
    [IsCyclic (MulAction.stabilizer G x)] {g:G} {p:ℕ} (hp:0<p) (order:orderOf g=p)
    (exp:∀a:G,a^p=1) (fix:g • x=x) : MulAction.stabilizer G x=Subgroup.zpowers g := by
  let H:=MulAction.stabilizer G x
  have incl:Subgroup.zpowers g≤H:=Subgroup.zpowers_le.mpr fix
  haveI : Fintype H:=Fintype.ofFinite H
  have pow (a:H):a^p=1:=Subtype.ext (exp a.val)
  have bound:Nat.card H≤p:=by
    rw [Nat.card_eq_fintype_card]
    calc
      Fintype.card H = (Finset.univ.filter (fun a:H=>a^p=1)).card := by simp [pow]
      _ ≤ p := IsCyclic.card_pow_eq_one_le hp
  apply Eq.symm
  apply Subgroup.eq_of_le_of_card_ge incl
  rwa [Nat.card_zpowers,order]
theorem groups : OMA.R_CongruentNumber_Tunnell_even_R1_H2_R1_H2_R1_H2_R1_H2_R1_H2_R1_H2_R1_H1_R1_H1_R1_H3_R1_H1_R1_H3_R1_H2_R1_H1_R1_H1_R1_H2_R1_H1_R1.H2 := by
  intro primes
  intro D N _ _ _ _ _ _ _ p hp comm exp g order
  let H:=Subgroup.zpowers g
  let M:=IntermediateField.fixedField H
  letI : NumberField M:=NumberField.of_module_finite D M
  letI : IsGalois M N:=IsGalois.tower_top_of_isGalois D M N
  have deg:Module.finrank M N=p := (IntermediateField.finrank_fixedField_eq_card H).trans ((Nat.card_zpowers g).trans order)
  let U: Set (HeightOneSpectrum (𝓞 M)):={q|Nat.card (q.asIdeal.primesOver (𝓞 N))=1}
  have inf:U.Infinite:=primes M N (deg ▸ hp)
  let image:=finitePlaceBelow (K:=D) '' U
  have imageInf:image.Infinite:=by
    intro hf
    exact inf ((Set.Finite.preimage_finitePlaceBelow (K:=D) (L:=M) hf).subset (fun q hq=>⟨q,hq,rfl⟩))
  let ram:=AlgebraicNumberTheory.Ramification.finite_ramified_base_heightOne_primes (𝓞 D) (𝓞 N)
  apply (imageInf.sdiff ram).mono
  rintro v ⟨⟨q,hq,rfl⟩,unram⟩ t hlie a
  let v:=finitePlaceBelow (K:=D) q
  letI : q.asIdeal.LiesOver v.asIdeal:=⟨rfl⟩
  letI : t.asIdeal.LiesOver v.asIdeal:=hlie
  letI : Algebra.IsUnramifiedAt (𝓞 D) t.asIdeal:=by
    by_contra hn
    exact unram ⟨t,hlie,hn⟩
  letI : IsCyclic (MulAction.stabilizer Gal(N/D) t.asIdeal):=TunnellIdealStabilizer.cyclic D N v t
  let w:=finitePlaceExtensionCentre (K:=M) (L:=N) q (chosenFinitePlaceExtension (L:=N) q)
  have below:finitePlaceBelow (K:=M) w=q:=finitePlaceBelow_finitePlaceExtensionCentre q _
  letI : w.asIdeal.LiesOver q.asIdeal:=⟨(congrArg HeightOneSpectrum.asIdeal below).symm⟩
  letI : w.asIdeal.LiesOver v.asIdeal:=Ideal.LiesOver.trans w.asIdeal q.asIdeal v.asIdeal
  let gm:Gal(N/M):={g.toRingEquiv with commutes':=fun x=> (IntermediateField.mem_fixedField_iff H _).mp x.property g (Subgroup.mem_zpowers g)}
  let W: q.asIdeal.primesOver (𝓞 N):=Ideal.primesOver.mk _ w.asIdeal
  haveI : Subsingleton (q.asIdeal.primesOver (𝓞 N)) := (Nat.card_eq_one_iff_unique.mp hq).1
  have gfix:g • w.asIdeal = w.asIdeal := by
    have h : gm • w.asIdeal=w.asIdeal:=congrArg Subtype.val (Subsingleton.elim (Ideal.primesOver.mk q.asIdeal (gm • w.asIdeal)) W)
    calc
      g • w.asIdeal = gm • w.asIdeal := by
        apply Ideal.ext
        intro x
        rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem,Ideal.mem_pointwise_smul_iff_inv_smul_mem]
        rfl
      _ = w.asIdeal := h
  obtain ⟨s,hs⟩:=Ideal.exists_smul_eq_of_isGaloisGroup v.asIdeal w.asIdeal t.asIdeal Gal(N/D)
  have gt:g • t.asIdeal=t.asIdeal:=by
    rw [←hs,←mul_smul,comm.is_comm.comm g s,mul_smul,gfix]
  have group:=stabilizes_of_cyclic t.asIdeal hp.pos order exp gt
  rw [←group]
  constructor
  · intro h
    change a • t.asIdeal=t.asIdeal
    rw [Ideal.pointwise_smul_eq_comap]
    exact congrArg HeightOneSpectrum.asIdeal h
  · intro h
    apply HeightOneSpectrum.ext
    change a • t.asIdeal=t.asIdeal at h
    rw [Ideal.pointwise_smul_eq_comap] at h
    exact h
end
end TunnellFrobeniusGroups

theorem OMA.solution : OMA.R_CongruentNumber_Tunnell_even_R1_H2_R1_H2_R1_H2_R1_H2_R1_H2_R1_H2_R1_H1_R1_H1_R1_H3_R1_H1_R1_H3_R1_H2_R1_H1_R1_H1_R1_H2_R1_H1_R1.H2 := TunnellFrobeniusGroups.groups
