import Mathlib.GroupTheory.SchurZassenhaus
import Mathlib.GroupTheory.Sylow
import Mathlib.GroupTheory.FiniteAbelian.Basic
import Mathlib.Tactic

/-! Descent of division through finite abelian groups acting on p-primary torsion. -/

namespace TunnellAbelianDescent

variable {G A : Type*} [Group G] [Finite G] [AddCommGroup A] [DistribMulAction G A]

/-- A finite p-group acting on an abelian group of exponent p^r fixes a nonzero point
    whenever the group is nonzero. Only the subgroup generated by a single orbit is finite. -/
lemma pgroup_fixed_nonzero {p r : ℕ} [Fact p.Prime] (hG : IsPGroup p G)
    (ha : ∀ x : A, p^r • x =0) (x : A) (hx : x≠0) :
    ∃ y : A, y≠0 ∧ ∀ g : G, g • y = y := by
  let s : Set A := Set.range (fun g : G => g • x)
  let U := AddSubgroup.closure s
  have hsfin : Finite s := (Set.finite_range _).to_subtype
  have hstab (g : G) (a : A) (h : a∈U) : g • a ∈ U := by
    induction h using AddSubgroup.closure_induction with
    | mem a h =>
      obtain ⟨t,rfl⟩ := h
      exact AddSubgroup.subset_closure ⟨g*t,mul_smul ..⟩
    | zero => simpa using U.zero_mem
    | add _ _ _ _ ha hb => simpa using U.add_mem ha hb
    | neg _ _ ha => simpa using U.neg_mem ha
  letI instAction : MulAction G U := {
    smul g a := ⟨g • (a:A),hstab g _ a.property⟩
    one_smul a := Subtype.ext (one_smul G (a:A))
    mul_smul g t a := Subtype.ext (mul_smul g t (a:A)) }
  have : AddGroup.FG U := AddGroup.closure_finite_fg s
  have : Finite U := AddCommGroup.finite_of_fg_isAddTorsion U (fun u =>
    isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨p^r,pow_pos (Fact.out : p.Prime).pos _,Subtype.ext (ha u)⟩)
  let x' : U := ⟨x,AddSubgroup.subset_closure ⟨1,one_smul G x⟩⟩
  have hpU : p ∣ Nat.card U := by
    by_contra hn
    have hc := ((Fact.out : p.Prime).coprime_iff_not_dvd.mpr hn).pow_left r
    have h₁ : addOrderOf x' ∣ p^r := addOrderOf_dvd_of_nsmul_eq_zero (Subtype.ext (ha x):p^r • x'=0)
    have h₂ : addOrderOf x' ∣ Nat.card U := addOrderOf_dvd_natCard _
    have h₃ := Nat.dvd_gcd h₁ h₂
    rw [hc.gcd_eq_one,Nat.dvd_one,AddMonoid.addOrderOf_eq_one_iff] at h₃
    exact hx (congrArg Subtype.val h₃)
  have hzero : (0:U) ∈ MulAction.fixedPoints G U := fun g => Subtype.ext (smul_zero g)
  obtain ⟨y,hy,hy0⟩ := hG.exists_fixed_point_of_prime_dvd_card_of_fixed_point U hpU hzero
  exact ⟨y,fun h => hy0 (Subtype.ext h.symm),fun g => congrArg Subtype.val (hy g)⟩

section Abelian

variable {B M : Type*} [CommGroup B] [Finite B] [AddCommGroup M] [DistribMulAction B M]

private def fixedSubgroup (H : Subgroup B) : AddSubgroup M where
  carrier := {x | ∀ h : H, (h:B) • x = x}
  zero_mem' h := smul_zero _
  add_mem' hx hy h := by rw [smul_add,hx h,hy h]
  neg_mem' hx h := by rw [smul_neg,hx h]

private lemma fixed_hall_zero {p r : ℕ} [Fact p.Prime] (P : Sylow p B) (H : Subgroup B)
    (hPH : P.toSubgroup.IsComplement' H) (hexp : ∀ x : M, p^r • x=0)
    (hinv : ∀ x : M, (∀ g : B, g•x=x) → x=0)
    (x : M) (hx : ∀ h:H, (h:B)•x=x) : x=0 := by
  let N := fixedSubgroup (M:=M) H
  have stable (g:P) (y:N) (h:H) : (h:B) • ((g:B) • (y:M)) = (g:B) • y := by
    rw [← mul_smul,mul_comm,mul_smul,y.property h]
  letI act : DistribMulAction P N := {
    smul g y := ⟨(g:B) • (y:M),stable g y⟩
    one_smul y := Subtype.ext (one_smul B (y:M))
    mul_smul g f y := Subtype.ext (mul_smul (g:B) (f:B) (y:M))
    smul_zero g := Subtype.ext (smul_zero (g:B))
    smul_add g x y := Subtype.ext (smul_add (g:B) (x:M) (y:M)) }
  by_contra h
  let x' : N := ⟨x,hx⟩
  have hx' : x' ≠ 0 := fun e => h (congrArg Subtype.val e)
  obtain ⟨y,hy,hfix⟩ := pgroup_fixed_nonzero P.isPGroup' (fun z:N => Subtype.ext (hexp z)) x' hx'
  apply hy
  apply Subtype.ext
  apply hinv
  intro b
  have hprod := hPH.equiv_fst_mul_equiv_snd b
  rw [← hprod,mul_smul,y.property]
  exact congrArg Subtype.val (hfix _)

/-- Vanishing of H¹ for a finite abelian group acting without invariants on p-primary
    torsion. The coefficient group can be infinite. -/
theorem cocycle_is_coboundary {p r : ℕ} [Fact p.Prime] (hexp : ∀ x : M, p^r • x=0)
    (hinv : ∀ x : M, (∀ g : B, g • x=x) → x=0)
    (c : B → M) (hc : ∀ g h, c (g*h)=c g + g • c h) :
    ∃ t : M, ∀ g, c g=g • t - t := by
  classical
  let P : Sylow p B := default
  obtain ⟨H,hPH⟩ := Subgroup.exists_right_complement'_of_coprime P.card_coprime_index
  letI := Fintype.ofFinite H
  let d := Fintype.card H
  have hpd : ¬p∣d := by simpa only [d,← Nat.card_eq_fintype_card,←hPH.symm.index_eq_card] using P.not_dvd_index
  have hcop : d.Coprime (p^r) := ((Fact.out:p.Prime).coprime_iff_not_dvd.mpr hpd).symm.pow_right r
  let k := d.gcdA (p^r)
  have hinvD (x:M) : k • (d • x)=x := by
    have h := Nat.gcd_eq_gcd_ab d (p^r)
    rw [hcop.gcd_eq_one] at h
    have eq := congrArg (fun j:ℤ => j • x) h
    simp only [Nat.cast_one,one_smul,add_smul,mul_comm (d:ℤ),mul_comm ((p^r:ℕ):ℤ),mul_smul,
      natCast_zsmul,hexp,smul_zero,add_zero] at eq
    exact eq.symm
  let S := ∑ h:H, c h
  have hS (h:H) : S=d • c h +(h:B) • S := by
    have reindex := Equiv.sum_comp (Equiv.mulLeft h) (fun k:H => c k)
    calc
      S = ∑ k:H, c ((h*k:H):B) := reindex.symm
      _ = _ := by simp [S,d,hc,Finset.sum_add_distrib,Finset.smul_sum]
  let t := -k • S
  have hct (h:H) : c h=(h:B) • t-t := by
    have he : d • c h=S-(h:B) • S := eq_sub_iff_add_eq.mpr (hS h).symm
    rw [← hinvD (c h),he,smul_sub]
    dsimp [t]
    rw [smul_comm (h:B) (-k)]
    simp only [neg_smul]
    abel
  let e (g:B) := c g-(g • t-t)
  have he (g h:B) : e (g*h)=e g+g • e h := by
    dsimp [e]; rw [hc,mul_smul,smul_sub,smul_sub]; abel
  refine ⟨t,fun g => sub_eq_zero.mp (fixed_hall_zero P H hPH hexp hinv (e g) ?_)⟩
  intro h
  have h0 : e (h:B)=0 := sub_eq_zero.mpr (hct h)
  have hh := he (h:B) g
  rw [mul_comm,he,h0,zero_add,smul_zero,add_zero] at hh
  exact hh.symm

end Abelian

end TunnellAbelianDescent
