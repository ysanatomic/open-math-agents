set_option maxHeartbeats 3500000 in
theorem main : H1 → H2 → OMA.R_CongruentNumber_Tunnell_even_R1_H2_R1_H2_R1_H2_R1_H2_R1_H2_R1_H1_R1_H1_R1_H1_R1_H2_R1.H1 := by
  intro geom lift
  intro n hn M h₁ h₂ hP
  refine ⟨0,fun p _ hp hsplit good q hq hT w z hz he=>?_⟩
  let K:=ℚ⟮I⟯
  let Ω:=algebraicClosure K ℂ
  let A(r:ℕ):=(let s:=M.ω₁/(q:ℂ)^r;(adjoin K {M.weierstrassP s,M.derivWeierstrassP s/2}).comap Ω.val)
  let T:=A 1
  letI:NumberField T:=hT
  obtain ⟨r,h,hD,v,N,hN,ab,deg,i,hi,hu,⟨x,y,hxy,l,P,gen,gauss⟩,hl⟩:=geom n hn M h₁ h₂ hP p hp hsplit good q hq w z hz he
  let D:=A (r+1)
  letI:Algebra T D:=(inclusion h).toAlgebra
  letI:NumberField D:=hD
  letI:NumberField N:=hN
  letI:IsAbelianGalois D N:=ab
  letI:FiniteDimensional D N:=Module.Finite.of_restrictScalars_finite ℚ D N
  obtain ⟨⟨P',hm⟩,unram⟩:=lift D N n p (r+1) q i hp good hq hi x y hxy l P gen gauss
  exact ⟨r,h,hD,v,N,hN,ab,fun j hne hp' t ht=>unram j t hp' (hu j hne) ht,⟨x,y,hxy,P',gen,hm⟩,deg,hl⟩

