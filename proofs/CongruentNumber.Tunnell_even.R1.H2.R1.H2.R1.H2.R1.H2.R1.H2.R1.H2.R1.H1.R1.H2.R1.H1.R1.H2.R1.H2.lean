/- TunnellTensorAbsoluteNorm -/
section
namespace TunnellTensorAbsoluteNorm
open RelativeIdeleGroup
open scoped TensorProduct
noncomputable section
universe u v w z
variable {K:Type u} {L:Type v} {M:Type w} [Field K] [Field L] [Field M]
  [Algebra K L] [Algebra K M] [FiniteDimensional K L] [Algebra.IsSeparable K L] [IsAlgClosed M]
theorem map_norm_prod
    [Infinite K]
    {ι : Type z} [Fintype ι] [DecidableEq ι]
    (b : Module.Basis ι K L) :
    MvPolynomial.map (algebraMap K M)
        (normPolynomial b) =
      embeddingProductPolynomial (M := M) b := by
  apply MvPolynomial.funext_set
    (fun _ : ι ↦ Set.range (algebraMap K M))
  · intro i
    exact Set.infinite_range_of_injective
      (algebraMap K M).injective
  · intro c hc
    choose d hd using fun i ↦
      hc i (Set.mem_univ i)
    let x : L :=
      b.repr.symm (Finsupp.equivFunOnFinite.symm d)
    have hcoords :
        c = fun i ↦
          algebraMap K M (b.repr x i) := by
      funext i
      calc
        c i = algebraMap K M (d i) :=
          (hd i).symm
        _ = algebraMap K M (b.repr x i) := by
          simp [x]
    rw [hcoords, eval_embeddingProductPolynomial]
    rw [MvPolynomial.eval_map]
    change MvPolynomial.eval₂ (algebraMap K M)
        ((algebraMap K M) ∘
          fun i ↦ b.repr x i)
        (normPolynomial b) =
      _
    rw [← MvPolynomial.eval₂_comp]
    rw [eval_normPolynomial]
    exact
      Algebra.norm_eq_prod_embeddings K M x
theorem norm_product
    [Infinite K]
    (A : Type*) [CommRing A] [Algebra K A]
    [Nontrivial A] (x : A ⊗[K] L) :
    (Algebra.TensorProduct.includeLeft
      (R := K) (S := K) (A := A) (B := M))
        (Algebra.norm A x) =
      ∏ f : L →ₐ[K] M,
        scalarEmbedding A f x := by
  classical
  let b := Module.Free.chooseBasis K L
  let c : Module.Free.ChooseBasisIndex K L → A :=
    fun i ↦
      (Algebra.TensorProduct.basis A b).repr x i
  let iL : A →+* A ⊗[K] M :=
    (Algebra.TensorProduct.includeLeft
      (R := K) (S := K) (A := A) (B := M)).toRingHom
  let iR : M →+* A ⊗[K] M :=
    (Algebra.TensorProduct.includeRight
      (R := K) (A := A) (B := M)).toRingHom
  have hmaps :
      iL.comp (algebraMap K A) =
        iR.comp (algebraMap K M) := by
    ext t
    simp [iL, iR]
  have hleft :
      MvPolynomial.eval₂ iR
          (fun i ↦ iL (c i))
          (MvPolynomial.map (algebraMap K M)
            (normPolynomial b)) =
        iL (Algebra.norm A x) := by
    rw [MvPolynomial.eval₂_map]
    rw [← hmaps]
    rw [← MvPolynomial.hom_eval₂]
    rw [eval₂_normPolynomial_baseChange]
  have hright :
      MvPolynomial.eval₂ iR
          (fun i ↦ iL (c i))
          (embeddingProductPolynomial
            (M := M) b) =
        ∏ f : L →ₐ[K] M,
          scalarEmbedding A f x := by
    rw [embeddingProductPolynomial,
      MvPolynomial.eval₂_prod]
    apply Finset.prod_congr rfl
    intro f hf
    exact
      eval₂_embeddingPolynomial_baseChange
        A b f x
  change iL (Algebra.norm A x) =
    ∏ f : L →ₐ[K] M,
      scalarEmbedding A f x
  rw [← hright, ← hleft,
    map_norm_prod b]
end
end TunnellTensorAbsoluteNorm
end
/- TunnellTensorCoefficientDescent -/
section
namespace TunnellTensorCoefficientDescent
open scoped TensorProduct
noncomputable section
variable {k R D F : Type*} [Field k] [CommRing R] [Algebra k R]
  [Field D] [Field F] [Algebra k D] [Algebra k F]
abbrev includeMap (j : D →ₐ[k] F) := Algebra.TensorProduct.map j (AlgHom.id k R)
theorem coefficient {ι : Type*} (b : Module.Basis ι k R) (j : D →ₐ[k] F)
    (t : D ⊗[k] R) (i : ι) :
    (b.baseChange F).repr (includeMap j t) i = j ((b.baseChange D).repr t i) := by
  induction t using TensorProduct.induction_on with
  | zero => simp
  | tmul x y => simp [includeMap,Algebra.smul_def]
  | add a b ha hb => simp [ha,hb]
theorem injective (j : D →ₐ[k] F) : Function.Injective (includeMap (R:=R) j) := by
  let b := Module.Free.chooseBasis k R
  intro x y h
  apply (b.baseChange D).repr.injective
  ext i
  exact j.injective ((coefficient b j x i).symm.trans
    ((congrArg (fun t => (b.baseChange F).repr t i) h).trans (coefficient b j y i)))
theorem tensor_mem {ι : Type*} (b : Module.Basis ι k R) (j : D →ₐ[k] F)
    {t : F ⊗[k] R} (hc : ∀ i, (b.baseChange F).repr t i ∈ j.range) :
    t ∈ (includeMap j).range := by
  classical
  choose c h using hc
  let a := ∑ i ∈ ((b.baseChange F).repr t).support, c i ⊗ₜ[k] b i
  refine ⟨a,?_⟩
  change includeMap j (∑ i ∈ _, c i ⊗ₜ[k] b i) = _
  rw [map_sum]
  conv_rhs => rw [← (b.baseChange F).linearCombination_repr t,Finsupp.linearCombination_apply,Finsupp.sum]
  apply Finset.sum_congr rfl
  intro i _
  have hi : j (c i) = (b.baseChange F).repr t i := h i
  rw [Algebra.TensorProduct.map_tmul, hi,Module.Basis.baseChange_apply]
  simp [TensorProduct.smul_tmul']
def action (g : F ≃ₐ[k] F) : F ⊗[k] R ≃ₐ[k] F ⊗[k] R :=
  Algebra.TensorProduct.congr g (AlgEquiv.refl (R:=k) (A₁:=R))
abbrev scalar (c:Fˣ) : (F ⊗[k] R)ˣ :=
  Units.map (algebraMap F (F ⊗[k] R)).toMonoidHom c
theorem normalize {ι : Type*} (b : Module.Basis ι k R) (u : (F ⊗[k] R)ˣ)
    (g : F ≃ₐ[k] F) (c : Fˣ) (h : Units.mapEquiv (action (R:=R) g).toMulEquiv u = scalar c * u)
    (i : ι) (hi : (b.baseChange F).repr u.val i ≠ 0) :
    let x := (b.baseChange F).repr u.val i
    let t := x⁻¹ • u.val
    action g t = t := by
  let x := (b.baseChange F).repr u.val i
  have hu : action g u.val = c.val • u.val := by
    rw [Algebra.smul_def]
    exact congrArg Units.val h
  have hx : g x = c.val * x := by
    calc
      g x = (b.baseChange F).repr (action g u.val) i := (coefficient b g.toAlgHom u.val i).symm
      _ = c.val*x := by rw [hu]; simp [x]
  change action g (x⁻¹ • u.val) = x⁻¹ • u.val
  simp only [Algebra.smul_def,map_mul]
  rw [hu]
  have scal (y:F) : action (R:=R) g (algebraMap F _ y) = algebraMap F _ (g y) := by
    change g y ⊗ₜ[k] (1 : R) = _
    rfl
  rw [scal,map_inv₀,hx]
  rw [Algebra.smul_def,← mul_assoc,← map_mul]
  simp [mul_comm, mul_left_comm, mul_assoc]
end
end TunnellTensorCoefficientDescent
end
/- TunnellTensorUnitFixed -/
section
namespace TunnellTensorUnitFixed
open TunnellTensorCoefficientDescent
open scoped TensorProduct
noncomputable section
variable {k R D F : Type} [Field k] [CommRing R] [Nontrivial R] [Algebra k R]
  [Field D] [Field F] [Algebra k D] [Algebra k F] [IsGalois k F]
abbrev inc (j : D →ₐ[k] F) := Units.map (includeMap (R:=R) j).toMonoidHom
abbrev act (g : F ≃ₐ[k] F) := Units.mapEquiv (action (R:=R) g).toMulEquiv
abbrev factor (E : Type) [Field E] [Algebra k E] :=
  Units.map (algebraMap E (E ⊗[k] R)).toMonoidHom
abbrev cls (E : Type) [Field E] [Algebra k E] :=
  QuotientGroup.mk' (factor (k:=k) (R:=R) E).range
theorem tensor_fixed (j : D →ₐ[k] F) (t : F ⊗[k] R)
    (h : ∀ g ∈ j.fieldRange.fixingSubgroup, action g t = t) :
    t ∈ (includeMap j).range := by
  let b := Module.Free.chooseBasis k R
  apply tensor_mem b j
  intro i
  change (b.baseChange F).repr t i ∈ j.fieldRange
  rw [← InfiniteGalois.fixedField_fixingSubgroup j.fieldRange,IntermediateField.mem_fixedField_iff]
  intro g hg
  exact (coefficient b g.toAlgHom t i).symm.trans
    (congrArg (fun z => (b.baseChange F).repr z i) (h g hg))
theorem unit_fixed (j : D →ₐ[k] F) (u : (F ⊗[k] R)ˣ)
    (h : ∀ g ∈ j.fieldRange.fixingSubgroup, act g u = u) :
    u ∈ (inc j).range := by
  obtain ⟨a,ha⟩ := tensor_fixed j u.val (fun g hg => congrArg Units.val (h g hg))
  obtain ⟨b,hb⟩ := tensor_fixed j (u⁻¹).val (fun g hg => congrArg Units.val
    ((map_inv (act g) u).trans (congrArg Inv.inv (h g hg))))
  change includeMap j a = u.val at ha
  change includeMap j b = (u⁻¹).val at hb
  have hab : a*b=1 := injective j (by rw [map_mul,ha,hb,Units.mul_inv,map_one])
  exact ⟨⟨a,b,hab,(mul_comm ..).trans hab⟩,Units.ext ha⟩
theorem projective_fixed (j : D →ₐ[k] F) (u : (F ⊗[k] R)ˣ)
    (h : ∀ g ∈ j.fieldRange.fixingSubgroup, cls F (act g u) = cls F u) :
    ∃ z : (D ⊗[k] R)ˣ, cls F (inc j z) = cls F u := by
  classical
  let b := Module.Free.chooseBasis k R
  obtain ⟨i,hi⟩ : ∃ i, (b.baseChange F).repr u.val i ≠ 0 := by
    by_contra! hh
    have hz : (b.baseChange F).repr u.val=0 := Finsupp.ext hh
    exact u.ne_zero ((b.baseChange F).repr.injective (hz.trans (map_zero _).symm))
  let y : Fˣ := Units.mk0 ((b.baseChange F).repr u.val i) hi
  let t : (F ⊗[k] R)ˣ := factor (k:=k) (R:=R) F y⁻¹ * u
  have ht (g) (hg : g ∈ j.fieldRange.fixingSubgroup) : act g t = t := by
    obtain ⟨c,hc⟩ := QuotientGroup.eq_iff_div_mem.mp (h g hg)
    have hu : act g u = scalar c * u := (div_eq_iff_eq_mul.mp hc.symm)
    apply Units.ext
    have hn := TunnellTensorCoefficientDescent.normalize b u g c hu i hi
    dsimp only at hn
    rw [Algebra.smul_def] at hn
    exact hn
  obtain ⟨z,hz⟩ := unit_fixed j t ht
  refine ⟨z,?_⟩
  rw [hz,map_mul]
  have hy : cls F (factor (k:=k) (R:=R) F y⁻¹) = 1 := (QuotientGroup.eq_one_iff _).mpr ⟨_,rfl⟩
  rw [hy]
  exact one_mul (cls (k:=k) (R:=R) F u)
end
end TunnellTensorUnitFixed
end
/- TunnellTensorProjectiveClass -/
section
namespace TunnellTensorProjectiveClass
open TunnellTensorCoefficientDescent TunnellTensorUnitFixed
open scoped TensorProduct
noncomputable section
variable {k R D F : Type} [Field k] [CommRing R] [Nontrivial R] [Algebra k R]
  [Field D] [Field F] [Algebra k D] [Algebra k F]
abbrev T (F R : Type) [Field F] [CommRing R] [Algebra k F] [Algebra k R] := F ⊗[k] R
abbrev Q (F R : Type) [Field F] [CommRing R] [Algebra k F] [Algebra k R] :=
  (F ⊗[k] R)ˣ ⧸ (factor (k:=k) (R:=R) F).range
local instance unitAction : MulDistribMulAction Gal(F/k) (F ⊗[k] R)ˣ where
  smul := fun g u => act g u
  one_smul u := by
    apply Units.ext
    change action (1 : Gal(F/k)) u.val = u.val
    induction u.val using TensorProduct.induction_on with
    | zero => simp
    | tmul => rfl
    | add a b ha hb => simp [ha,hb]
  mul_smul g f u := by
    apply Units.ext
    change action (g*f) u.val = action g (action f u.val)
    induction u.val using TensorProduct.induction_on with
    | zero => simp
    | tmul => rfl
    | add a b ha hb => simp [ha,hb]
  smul_one g := map_one (act g)
  smul_mul g u v := map_mul (act g) u v
local instance classAction : MulDistribMulAction Gal(F/k) (Q (k:=k) F R) :=
  CyclicCohomology.stableQuotientMulDistribMulAction _ (by
    intro g u hu
    obtain ⟨x,rfl⟩ := hu
    exact ⟨Units.map g.toRingHom.toMonoidHom x, rfl⟩)
def A (k R F : Type) [Field k] [CommRing R] [Algebra k R] [Field F] [Algebra k F] :
    Rep ℤ Gal(F/k) := Rep.ofMulDistribMulAction _ (Q (k:=k) F R)
variable [IsGalois k F]
abbrev H (j : D →ₐ[k] F) : ClosedSubgroup Gal(F/k) :=
  ⟨j.fieldRange.fixingSubgroup,InfiniteGalois.fixingSubgroup_isClosed _⟩
abbrev V (j : D →ₐ[k] F) :=
  let M:=A k R F
  letI:Module ℤ M.V:=M.hV2
  (Representation.invariants (M.ρ.comp (H j).toSubgroup.subtype)).toAddSubgroup
theorem action_inc (j : D →ₐ[k] F) (u : (D ⊗[k] R)ˣ) (g : Gal(F/k)) (hg : g ∈ H j) :
    act g (inc j u) = inc j u := by
  apply Units.ext
  change action g (includeMap j (u.val)) = includeMap j u.val
  induction u.val using TensorProduct.induction_on with
  | zero => simp
  | tmul d r =>
    change g (j d) ⊗ₜ[k] r = j d ⊗ₜ[k] r
    exact congrArg (fun z:F => z ⊗ₜ[k] r) ((IntermediateField.mem_fixingSubgroup_iff j.fieldRange g).mp hg (j d) ⟨d,rfl⟩)
  | add a b ha hb => simp [ha,hb]
def fixed (j : D →ₐ[k] F) : (D ⊗[k] R)ˣ →* Multiplicative (V (R:=R) j) where
  toFun u := Multiplicative.ofAdd ⟨Additive.ofMul (cls F (inc j u)), by
    intro g
    exact congrArg (fun t => Additive.ofMul (cls F t)) (action_inc j u g.val g.property)⟩
  map_one' := by
    apply congrArg Multiplicative.ofAdd
    apply Subtype.ext
    exact congrArg Additive.ofMul (map_one ((cls F).comp (inc j)))
  map_mul' x y := by
    apply congrArg Multiplicative.ofAdd
    apply Subtype.ext
    exact congrArg Additive.ofMul (map_mul ((cls F).comp (inc j)) x y)
theorem onto (j : D →ₐ[k] F) : Function.Surjective (fixed (R:=R) j) := by
  intro a
  obtain ⟨u,hu⟩ := QuotientGroup.mk'_surjective (factor (k:=k) (R:=R) F).range a.toAdd.val.toMul
  obtain ⟨z,hz⟩ := projective_fixed j u (by
    intro g hg
    have hh := a.toAdd.property ⟨g,hg⟩
    have point : (A k R F).ρ g (Additive.ofMul (cls F u)) = Additive.ofMul (cls F u) := by
      rw [hu]
      exact hh
    exact Additive.ofMul.injective point)
  exact ⟨z,congrArg Multiplicative.ofAdd (Subtype.ext (congrArg Additive.ofMul (hz.trans hu)))⟩
theorem kernel (j : D →ₐ[k] F) :
    (fixed (R:=R) j).ker = (factor (k:=k) (R:=R) D).range := by
  ext u
  constructor
  · intro h
    have h1 : cls F (inc j u) = 1 := congrArg (fun a => (Multiplicative.toAdd a).val.toMul) h
    obtain ⟨c,hc⟩ := (QuotientGroup.eq_one_iff _).mp h1
    have hf (g) (hg : g ∈ j.fieldRange.fixingSubgroup) : g c.val = c.val := by
      apply (algebraMap F (F ⊗[k] R)).injective
      have eq := action_inc j u g hg
      rw [← hc] at eq
      exact congrArg Units.val eq
    have hm : c.val ∈ j.fieldRange := by
      rw [← InfiniteGalois.fixedField_fixingSubgroup j.fieldRange,IntermediateField.mem_fixedField_iff]
      exact hf
    obtain ⟨d,hd⟩ := hm
    change j d = c.val at hd
    have hd0 : d ≠ 0 := by intro h; rw [h,map_zero] at hd; exact c.ne_zero hd.symm
    refine ⟨Units.mk0 d hd0, Units.ext (injective j ?_)⟩
    change j d ⊗ₜ[k] (1:R) = _
    rw [hd]
    exact congrArg Units.val hc
  · rintro ⟨d,rfl⟩
    apply congrArg Multiplicative.ofAdd
    apply Subtype.ext
    apply congrArg Additive.ofMul
    exact (QuotientGroup.eq_one_iff _).mpr ⟨Units.map j.toRingHom.toMonoidHom d,rfl⟩
end
end TunnellTensorProjectiveClass
end
/- TunnellTensorTowerNorm -/
section
namespace TunnellTensorTowerNorm
open TunnellTensorCoefficientDescent
open scoped TensorProduct
noncomputable section
variable {k : Type*} [Field k] (R D E : Type*) [CommRing R] [Field D] [Field E]
  [Algebra k R] [Algebra k D] [Algebra k E] [Algebra D E] [IsScalarTower k D E]
def flat : (D ⊗[k] R) ⊗[D] E ≃+* E ⊗[k] R :=
  (Algebra.TensorProduct.comm D _ _).toRingEquiv.trans
    (Algebra.TensorProduct.cancelBaseChange k D E E R).toRingEquiv
theorem flat_tmul (d : D) (r : R) (x : E) :
    flat (k:=k) R D E ((d ⊗ₜ[k] r) ⊗ₜ[D] x) = (d • x) ⊗ₜ[k] r := by
  simp [flat]
theorem flat_inl (a : D ⊗[k] R) :
    flat R D E (Algebra.TensorProduct.includeLeft (R:=D) (S:=D) (A:=D ⊗[k] R) (B:=E) a) =
      includeMap (IsScalarTower.toAlgHom k D E) a := by
  induction a using TensorProduct.induction_on with
  | zero => simp
  | tmul d r => simp [Algebra.TensorProduct.includeLeft_apply,flat_tmul,includeMap,Algebra.smul_def]
  | add a b ha hb => simp only [map_add,ha,hb]
theorem flat_map {F : Type*} [Field F] [Algebra k F] [Algebra D F] [IsScalarTower k D F]
    (f : E →ₐ[D] F) (a : (D ⊗[k] R) ⊗[D] E) :
    flat R D F (RelativeIdeleGroup.scalarEmbedding (D ⊗[k] R) f a) =
      includeMap (f.restrictScalars k) (flat R D E a) := by
  induction a using TensorProduct.induction_on with
  | zero => simp
  | tmul y x =>
    induction y using TensorProduct.induction_on with
    | zero => simp
    | tmul d r => simp [flat_tmul,includeMap]
    | add a b ha hb =>
      simp only [TensorProduct.add_tmul,map_add]
      exact congrArg₂ (·+·) ha hb
  | add a b ha hb => simp only [map_add,ha,hb]
theorem norm [Nontrivial R] [FiniteDimensional D E] [Algebra.IsSeparable D E] [Infinite D]
    (F : Type*) [Field F] [Algebra k F] [Algebra D F] [IsScalarTower k D F] [IsAlgClosed F]
    (a : (D ⊗[k] R) ⊗[D] E) :
    includeMap (IsScalarTower.toAlgHom k D F) (Algebra.norm (D ⊗[k] R) a) =
      ∏ f : E →ₐ[D] F, includeMap (f.restrictScalars k) (flat R D E a) := by
  have hn := TunnellTensorAbsoluteNorm.norm_product (K:=D) (L:=E) (M:=F) (D ⊗[k] R) a
  have h := congrArg (flat R D F) hn
  rw [flat_inl,map_prod] at h
  exact h.trans (Finset.prod_congr rfl fun f _ => flat_map R D E f a)
end
end TunnellTensorTowerNorm
end
/- TunnellTensorCosetEmbedding -/
section
namespace TunnellTensorCosetEmbedding
open TunnellRelativeUnitAction
noncomputable section
variable (k D F Ω : Type) [Field k] [Field D] [Field F] [Field Ω]
  [Algebra k D] [Algebra k F] [Algebra D F] [IsScalarTower k D F]
  [Algebra k Ω] [Algebra D Ω] [Algebra F Ω] [IsScalarTower k D Ω] [IsScalarTower k F Ω]
  [IsScalarTower D F Ω] [IsGalois k Ω] [Normal D Ω]
abbrev H := (fix k D Ω).toSubgroup
abbrev J := (fix k F Ω).toSubgroup.subgroupOf (H k D Ω)
def restrict (g : H k D Ω) : F →ₐ[D] Ω :=
  (fixEquiv k D Ω g).toAlgHom.comp (IsScalarTower.toAlgHom D F Ω)
theorem restrict_eq_iff (g h : H k D Ω) :
    restrict k D F Ω g = restrict k D F Ω h ↔ g⁻¹*h ∈ J k D F Ω := by
  rw [show g⁻¹*h ∈ J k D F Ω ↔ (g⁻¹*h).val ∈ fix k F Ω from Iff.rfl,fix_iff]
  constructor
  · intro he x
    have hval := DFunLike.congr_fun he x
    change g.val (algebraMap F Ω x) = h.val (algebraMap F Ω x) at hval
    change g.val.symm (h.val (algebraMap F Ω x)) = _
    rw [← hval,AlgEquiv.symm_apply_apply]
  · intro hf
    apply AlgHom.ext
    intro x
    change g.val (algebraMap F Ω x) = h.val (algebraMap F Ω x)
    have hc := congrArg g.val (hf x).symm
    exact hc.trans (g.val.apply_symm_apply _)
def onCoset (q : H k D Ω ⧸ J k D F Ω) : F →ₐ[D] Ω :=
  Quotient.liftOn' q (restrict k D F Ω) (fun g h r => (restrict_eq_iff k D F Ω g h).mpr (QuotientGroup.leftRel_apply.mp r))
def equiv : (H k D Ω ⧸ J k D F Ω) ≃ (F →ₐ[D] Ω) :=
  Equiv.ofBijective (onCoset k D F Ω) (by
    constructor
    · rintro q₁ q₂
      refine Quotient.inductionOn₂' q₁ q₂ ?_
      intro g h he
      exact QuotientGroup.eq.mpr ((restrict_eq_iff k D F Ω g h).mp he)
    · intro f
      let g := RelativeIdeleGroup.liftSubextensionEmbedding (K:=D) (L:=F) (M:=Ω) f
      refine ⟨QuotientGroup.mk ((fixEquiv k D Ω).symm g),?_⟩
      change (fixEquiv k D Ω ((fixEquiv k D Ω).symm g)).toAlgHom.comp _ = _
      rw [MulEquiv.apply_symm_apply]
      exact RelativeIdeleGroup.restrict_liftSubextensionEmbedding f)
theorem equiv_out (q : H k D Ω ⧸ J k D F Ω) (x : F) :
    equiv k D F Ω q x = q.out.val (algebraMap F Ω x) :=
  congrArg (fun p => onCoset k D F Ω p x) (Quotient.out_eq' q).symm
end
end TunnellTensorCosetEmbedding
end
/- TunnellTensorProjectiveNorm -/
section
namespace TunnellTensorProjectiveNorm
open TunnellTensorCoefficientDescent TunnellTensorUnitFixed TunnellTensorProjectiveClass
open scoped TensorProduct Classical
noncomputable section
variable {k D E Ω : Type} [Field k] [Field D] [Field E] [Field Ω]
  [Algebra k D] [Algebra k E] [Algebra D E] [IsScalarTower k D E]
  [Algebra k Ω] [Algebra D Ω] [Algebra E Ω] [IsScalarTower k D Ω]
  [IsScalarTower k E Ω] [IsScalarTower D E Ω] [IsGalois k Ω] [IsAlgClosed Ω]
  [FiniteDimensional D E] [Algebra.IsSeparable D E] [Infinite D]
variable (R : Type) [CommRing R] [Nontrivial R] [Algebra k R]
variable [Normal D Ω]
abbrev lower := IsScalarTower.toAlgHom k D Ω
abbrev upper := IsScalarTower.toAlgHom k E Ω
abbrev T := (D ⊗[k] R) ⊗[D] E
abbrev n := Units.map (Algebra.norm (D ⊗[k] R) (S:=T (k:=k) (D:=D) (E:=E) R))
abbrev top := (fixed (R:=R) (upper (k:=k) (E:=E) (Ω:=Ω))).comp
  (Units.mapEquiv (TunnellTensorTowerNorm.flat (k:=k) R D E).toMulEquiv).toMonoidHom
theorem act_inc (j : E →ₐ[k] Ω) (g : Ω ≃ₐ[k] Ω) (u : (E ⊗[k] R)ˣ) :
    act g (inc j u) = inc (g.toAlgHom.comp j) u := by
  apply Units.ext
  change action g (includeMap j u.val) = includeMap (g.toAlgHom.comp j) u.val
  induction u.val using TensorProduct.induction_on with
  | zero => simp
  | tmul => rfl
  | add a b ha hb => simp [ha,hb]
theorem product_norm (x : (T (k:=k) (D:=D) (E:=E) R)ˣ) :
    let C:=TunnellTensorCosetEmbedding.H k D Ω ⧸ TunnellTensorCosetEmbedding.J k D E Ω
    letI : Fintype C := Fintype.ofEquiv (E →ₐ[D] Ω) (TunnellTensorCosetEmbedding.equiv k D E Ω).symm
    inc (R:=R) (lower (k:=k) (D:=D) (Ω:=Ω)) (n (k:=k) (D:=D) (E:=E) R x) =
      ∏ q:C, act (q.out.val) (inc (upper (k:=k) (E:=E) (Ω:=Ω))
        (Units.mapEquiv (TunnellTensorTowerNorm.flat (k:=k) R D E).toMulEquiv x)) := by
  intro C
  let c := TunnellTensorCosetEmbedding.equiv k D E Ω
  letI : Fintype C := Fintype.ofEquiv (E →ₐ[D] Ω) c.symm
  apply Units.ext
  rw [Units.coe_prod]
  calc
    _ = ∏ f:E →ₐ[D] Ω, includeMap (f.restrictScalars k) (TunnellTensorTowerNorm.flat (k:=k) R D E x.val) :=
      TunnellTensorTowerNorm.norm R D E Ω x.val
    _ = ∏ q:C, includeMap ((c q).restrictScalars k) (TunnellTensorTowerNorm.flat (k:=k) R D E x.val) := (c.prod_comp _).symm
    _ = _ := by
      apply Finset.prod_congr rfl
      intro q _
      have eq : (c q).restrictScalars k = q.out.val.toAlgHom.comp (IsScalarTower.toAlgHom k E Ω) :=
        AlgHom.ext (TunnellTensorCosetEmbedding.equiv_out k D E Ω q)
      rw [eq,act_inc]
      rfl
theorem sum_norm (x : (T (k:=k) (D:=D) (E:=E) R)ˣ) :
    let A₀:=A k R Ω
    let H₀:=H (lower (k:=k) (D:=D) (Ω:=Ω))
    let J₀:=H (upper (k:=k) (E:=E) (Ω:=Ω))
    letI : Module ℤ A₀.V:=A₀.hV2
    ∑ᶠ q:H₀.toSubgroup ⧸ J₀.toSubgroup.subgroupOf H₀.toSubgroup,
      A₀.ρ q.out.val ((top (k:=k) (D:=D) (E:=E) (Ω:=Ω) R x).toAdd.val) =
      (fixed (R:=R) (lower (k:=k) (D:=D) (Ω:=Ω)) (n (k:=k) (D:=D) (E:=E) R x)).toAdd.val := by
  let C:=TunnellTensorCosetEmbedding.H k D Ω ⧸ TunnellTensorCosetEmbedding.J k D E Ω
  letI : Fintype C := Fintype.ofEquiv (E →ₐ[D] Ω) (TunnellTensorCosetEmbedding.equiv k D E Ω).symm
  let topUnit := inc (R:=R) (upper (k:=k) (E:=E) (Ω:=Ω))
    (Units.mapEquiv (TunnellTensorTowerNorm.flat (k:=k) R D E).toMulEquiv x)
  change (∑ᶠ q:C, Additive.ofMul (cls Ω (act q.out.val topUnit))) =
    Additive.ofMul (cls Ω (inc (lower (k:=k) (D:=D) (Ω:=Ω)) (n (k:=k) (D:=D) (E:=E) R x)))
  rw [finsum_eq_sum_of_fintype,← ofMul_prod]
  have h : cls (k:=k) (R:=R) Ω (∏ q:C, act q.out.val topUnit) =
      ∏ q:C, cls Ω (act q.out.val topUnit) := map_prod _ _ _
  have p := congrArg (cls (k:=k) (R:=R) Ω) (product_norm (Ω:=Ω) R x)
  exact congrArg Additive.ofMul (h.symm.trans p.symm)
theorem kernel_sup {X Y Z : Type} [CommGroup X] [Group Y] [Group Z]
    (f : X →* Z) (m : Y →* X) (x : X) :
    (∃ y, f (m y)=f x) ↔ x ∈ f.ker ⊔ m.range := by
  constructor
  · rintro ⟨y,hy⟩
    exact Subgroup.mem_sup.mpr ⟨_,(show x/m y ∈ f.ker by change f (x/m y)=1; rw [map_div,hy,div_self']),
      _,⟨y,rfl⟩,div_mul_cancel _ _⟩
  · intro h
    obtain ⟨z,hz,_,⟨y,rfl⟩,rfl⟩ := Subgroup.mem_sup.mp h
    exact ⟨y,by rw [map_mul,MonoidHom.mem_ker.mp hz,one_mul]⟩
end
end TunnellTensorProjectiveNorm
end
/- TunnellTensorScalarCharts -/
section
namespace TunnellTensorScalarTransport
open NumberField TunnellTensorCoefficientDescent TunnellTensorUnitFixed TunnellTensorProjectiveClass
open TunnellTensorTowerNorm
open scoped NumberField TensorProduct Classical
noncomputable section
abbrev R := AdeleRing (𝓞 ℚ) ℚ
abbrev Ω := SeparableClosure ℚ
instance chartGalois : IsGalois ℚ Ω :=
  @IsSepClosure.isGalois ℚ _ Ω _ ((separableClosure ℚ (AlgebraicClosure ℚ)).algebra)
    (separableClosure.isSepClosure ℚ (AlgebraicClosure ℚ))
abbrev R₀ (D:Type) [Field D] [NumberField D] := AdeleRing (𝓞 D) D
def Scalar : Prop := ∀ (D : Type) [Field D] [NumberField D],
  letI : Algebra D (R ⊗[ℚ] D) := Algebra.TensorProduct.rightAlgebra
  Nonempty ((R ⊗[ℚ] D) ≃ₐ[D] R₀ D)
variable (s : Scalar)
variable (D:Type) [Field D] [NumberField D]
def base : R₀ D ≃ₐ[D] D ⊗[ℚ] R :=
  letI : Algebra D (R ⊗[ℚ] D) := Algebra.TensorProduct.rightAlgebra
  (s D).some.symm.trans (Algebra.TensorProduct.commRight ℚ D R).symm
abbrev uBase := Units.mapEquiv (base s D).toMulEquiv
def i (j:D→ₐ[ℚ]Ω) := (fixed (R:=R) j).comp (uBase s D).toMonoidHom
theorem onto (j:D→ₐ[ℚ]Ω) : Function.Surjective (i s D j) :=
  (TunnellTensorProjectiveClass.onto j).comp (uBase s D).surjective
theorem kernel (j:D→ₐ[ℚ]Ω) :
    (i s D j).ker = (Units.map (algebraMap D (R₀ D)).toMonoidHom).range := by
  ext x
  change uBase s D x ∈ (fixed (R:=R) j).ker ↔ _
  rw [TunnellTensorProjectiveClass.kernel]
  constructor
  · rintro ⟨a,ha⟩
    refine ⟨a,(uBase s D).injective ?_⟩
    exact (Units.ext ((base s D).commutes a.val)).trans ha
  · rintro ⟨a,rfl⟩
    exact ⟨a,Units.ext ((base s D).commutes a.val).symm⟩
variable (F:Type) [Field F] [NumberField F] [Algebra D F] [FiniteDimensional D F]
abbrev T₀ := R₀ D ⊗[D] F
def ringExt : T₀ D F ≃ₐ[D] (D ⊗[ℚ] R) ⊗[D] F := Algebra.TensorProduct.congr (base s D) (AlgEquiv.refl (A₁:=F))
abbrev uExt := Units.mapEquiv (ringExt s D F).toMulEquiv
abbrev flatten := (ringExt s D F).toRingEquiv.trans (flat R D F)
abbrev uFlat := Units.mapEquiv (flatten s D F).toMulEquiv
abbrev m := Units.map (Algebra.norm (R₀ D) (S:=T₀ D F))
theorem flat_field (a : F) :
    flatten s D F (1 ⊗ₜ[D] a) = algebraMap F (F ⊗[ℚ] R) a := by
  change flat R D F (base s D 1 ⊗ₜ[D] a) = _
  rw [map_one]
  change flat R D F (((1:D) ⊗ₜ[ℚ] (1:R)) ⊗ₜ[D] a) = _
  rw [flat_tmul,one_smul]
  rfl
def upper (e:F →ₐ[ℚ] Ω) := (fixed (R:=R) e).comp (uFlat s D F).toMonoidHom
theorem upper_surj (e:F→ₐ[ℚ]Ω) : Function.Surjective (upper s D F e) :=
  (TunnellTensorProjectiveClass.onto e).comp (uFlat s D F).surjective
theorem upper_ker (e:F→ₐ[ℚ]Ω) :
    (upper s D F e).ker =
      (Units.map (Algebra.TensorProduct.includeRight (R:=D) (A:=R₀ D) (B:=F)).toMonoidHom).range := by
  ext x
  change uFlat s D F x ∈ (fixed (R:=R) e).ker ↔ _
  rw [TunnellTensorProjectiveClass.kernel]
  constructor
  · rintro ⟨a,ha⟩
    exact ⟨a,(uFlat s D F).injective ((Units.ext (flat_field s D F a.val)).trans ha)⟩
  · rintro ⟨a,rfl⟩
    exact ⟨a,Units.ext (flat_field s D F a.val).symm⟩
end
end TunnellTensorScalarTransport
end
/- TunnellTensorScalarTransport -/
section
namespace TunnellTensorScalarTransport
open NumberField TunnellTensorCoefficientDescent TunnellTensorUnitFixed TunnellTensorProjectiveClass
open TunnellTensorTowerNorm
open scoped NumberField TensorProduct Classical
noncomputable section
variable (s : Scalar)
variable (D F : Type) [Field D] [NumberField D] [Field F] [NumberField F] [Algebra D F] [FiniteDimensional D F]
theorem norm_ext (x : (T₀ D F)ˣ) :
    TunnellTensorProjectiveNorm.n R (uExt s D F x) = uBase s D (m D F x) := by
  apply Units.ext
  apply (base s D).symm.injective
  change (base s D).symm (Algebra.norm (D ⊗[ℚ] R) (ringExt s D F x.val)) =
    (base s D).symm (base s D (Algebra.norm (R₀ D) x.val))
  rw [AlgEquiv.symm_apply_apply]
  exact (Algebra.norm_eq_of_equiv_equiv (base s D).toRingEquiv (ringExt s D F).toRingEquiv
    (RingHom.ext fun _ => rfl) x.val).symm
theorem relative (j:D→ₐ[ℚ]Ω) (e:F→ₐ[ℚ]Ω) (he : ∀ a:D,e (algebraMap D F a)=j a)
    (x : (R₀ D)ˣ) :
    TunnellAbstractNormCoordinates.N (A ℚ R Ω) (H j) (H e) (i s D j x).toAdd.val ↔
    x ∈ (Units.map (algebraMap D (R₀ D)).toMonoidHom).range ⊔ (m D F).range := by
  letI : Algebra D Ω := j.toRingHom.toAlgebra
  letI : Algebra F Ω := e.toRingHom.toAlgebra
  letI : IsScalarTower ℚ D Ω := IsScalarTower.of_algebraMap_eq' (RingHom.ext_rat _ _)
  letI : IsScalarTower ℚ F Ω := IsScalarTower.of_algebraMap_eq' (RingHom.ext_rat _ _)
  letI : IsScalarTower D F Ω := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun a => (he a).symm)
  letI : Normal D Ω := (IsGalois.tower_top_of_isGalois ℚ D Ω).to_normal
  have eqj : IsScalarTower.toAlgHom ℚ D Ω = j := AlgHom.ext fun _ => rfl
  have eqe : IsScalarTower.toAlgHom ℚ F Ω = e := AlgHom.ext fun _ => rfl
  have sum (z:(T₀ D F)ˣ) :
      ∑ᶠ q:(H j).toSubgroup ⧸ (H e).toSubgroup.subgroupOf (H j).toSubgroup,
        (A ℚ R Ω).ρ q.out.val (upper s D F e z).toAdd.val = (i s D j (m D F z)).toAdd.val := by
    have h := TunnellTensorProjectiveNorm.sum_norm (Ω:=Ω) R (uExt s D F z)
    dsimp only [TunnellTensorProjectiveNorm.lower,TunnellTensorProjectiveNorm.upper] at h
    rw [norm_ext] at h
    exact h
  rw [← kernel s D j,← TunnellTensorProjectiveNorm.kernel_sup]
  constructor
  · rintro ⟨b,hb⟩
    obtain ⟨z,hz⟩ := upper_surj s D F e (Multiplicative.ofAdd b)
    refine ⟨z,congrArg Multiplicative.ofAdd (Subtype.ext ?_)⟩
    exact (sum z).symm.trans (by rw [hz]; exact hb)
  · rintro ⟨z,hz⟩
    exact ⟨(upper s D F e z).toAdd,(sum z).trans (congrArg (fun v => v.toAdd.val) hz)⟩
end
end TunnellTensorScalarTransport
end
/- TunnellTensorClassRealization -/
section
namespace TunnellTensorClassRealization
open TunnellTensorScalarTransport TunnellTensorProjectiveClass
open scoped Classical
noncomputable section
theorem of_tate (s : Scalar)
    (tate : TunnellGlobalFormationModel.CyclicClasses → TunnellAbstractNormCoordinates.Tate (A ℚ R Ω)) :
    TunnellGlobalClassModel.Realization := by
  intro c
  dsimp only
  intro _
  refine ⟨A ℚ R Ω,tate c,?_⟩
  intro D _ _ j
  refine ⟨i s D j,onto s D j,kernel s D j,?_⟩
  intro F _ _ _ _ e he z
  exact relative s D F j e he z
end
end TunnellTensorClassRealization
end
/- TunnellTensorTateAction -/
section
namespace TunnellTensorTateAction
open NumberField TunnellTensorCoefficientDescent TunnellTensorUnitFixed TunnellTensorProjectiveClass
open TunnellTensorScalarTransport TunnellTensorTowerNorm
open scoped NumberField TensorProduct
noncomputable section
variable (s:Scalar) (D E:Type) [Field D][NumberField D][Field E][NumberField E][Algebra D E][FiniteDimensional D E]
theorem ring_action (τ:Gal(E/D)) (z:T₀ D E) :
    ringExt s D E (RelativeIdeleGroup.conjugation D E τ z) =
      RelativeIdeleGroup.scalarEmbedding (D ⊗[ℚ] R) τ.toAlgHom (ringExt s D E z) := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul a x => rfl
  | add a b ha hb => simp [ha,hb]
theorem flat_action (τ:Gal(E/D)) (z:T₀ D E) :
    flatten s D E (RelativeIdeleGroup.conjugation D E τ z)=
      includeMap (τ.toAlgHom.restrictScalars ℚ) (flatten s D E z) := by
  change flat R D E (ringExt s D E (RelativeIdeleGroup.conjugation D E τ z))=_
  rw [ring_action]
  exact flat_map R D E τ.toAlgHom (ringExt s D E z)
theorem upper_act (e:E→ₐ[ℚ]Ω) (g:Gal(Ω/ℚ)) (τ:Gal(E/D)) (h:∀ x:E,g (e x)=e (τ x))
    (z:RelativeIdeleGroup D E) :
    (A ℚ R Ω).ρ g (upper s D E e z).toAdd.val =
      (upper s D E e (RelativeIdeleGroup.conjugationIdele D E τ z)).toAdd.val := by
  change Additive.ofMul (cls Ω (act g (inc e (uFlat s D E z)))) =
    Additive.ofMul (cls Ω (inc e (uFlat s D E (RelativeIdeleGroup.conjugationIdele D E τ z))))
  apply congrArg (fun x => Additive.ofMul (cls Ω x))
  apply Units.ext
  change action g (includeMap e (flatten s D E z.val)) =
    includeMap e (flatten s D E (RelativeIdeleGroup.conjugation D E τ z.val))
  rw [flat_action]
  generalize flatten s D E z.val=t
  induction t using TensorProduct.induction_on with
  | zero => simp
  | tmul x r => exact congrArg (fun a:Ω => a ⊗ₜ[ℚ] r) (h x)
  | add a b ha hb => simp [ha,hb]
end
end TunnellTensorTateAction
end
/- TunnellTensorTateEquivalence -/
section
namespace TunnellTensorTateEquivalence
open NumberField CyclicCohomology GlobalClassFieldTheory LocalClassFieldTheory CategoryTheory
open scoped NumberField Classical IsMulCommutative
noncomputable section
variable (D E:Type) [Field D][NumberField D][Field E][NumberField E][Algebra D E][FiniteDimensional D E][IsGalois D E]
variable (Q:Type) [Group Q] [Fintype Q] [IsCyclic Q] (d:Q ≃* Gal(E/D)) (M:Rep.{0} ℤ Q)
theorem result (data:TunnellGlobalFormationModel.CyclicClasses)
    (f:RelativeIdeleGroup D E →* Multiplicative M.V) (sf:Function.Surjective f)
    (hk:f.ker=RelativeIdeleGroup.principalSubgroup D E)
    (act:∀ (q:Q) x, M.ρ q (f x).toAdd=(f (RelativeIdeleGroup.conjugationIdele D E (d q) x)).toAdd) :
    Nat.card (tateCohomology M 0)=Nat.card Q ∧ Subsingleton (tateCohomology M (-1)) := by
  letI := RelativeIdeleGroup.Cohomology.ideleClassMulDistribMulAction D E
  let C:=RelativeIdeleGroup.ClassGroup D E
  let U:=Rep.ofMulDistribMulAction (Gal(E/D)) C
  let c:C ≃* Multiplicative M.V := (QuotientGroup.quotientMulEquivOfEq hk.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective f sf)
  have hc (x:RelativeIdeleGroup D E) : c (QuotientGroup.mk' (RelativeIdeleGroup.principalSubgroup D E) x)=f x := by
    dsimp only [c,MulEquiv.trans_apply]
    rw [QuotientGroup.mk'_apply,QuotientGroup.quotientMulEquivOfEq_mk]
    rfl
  let add : Additive C ≃+ M.V := c.toAdditive
  letI : Module ℤ M.V:=M.hV2
  let eInv : Rep.res d.toMonoidHom U ≅ M := by
    refine Rep.mkIso (Representation.Equiv.mk add.toIntLinearEquiv ?_)
    intro q
    apply LinearMap.ext
    intro t
    obtain ⟨b,hb⟩:=QuotientGroup.mk'_surjective (RelativeIdeleGroup.principalSubgroup D E) t.toMul
    obtain rfl : t=Additive.ofMul (QuotientGroup.mk' (RelativeIdeleGroup.principalSubgroup D E) b) := congrArg Additive.ofMul hb.symm
    change (c (QuotientGroup.mk' _ (RelativeIdeleGroup.conjugationIdele D E (d q) b))).toAdd =
      M.ρ q (c (QuotientGroup.mk' _ b)).toAdd
    rw [hc,hc]
    exact (act q b).symm
  obtain ⟨g,hg⟩:=IsCyclic.exists_generator (α:=Q)
  let g':=d g
  have hg' : ∀ t:Gal(E/D),t∈Subgroup.zpowers g' := map_cyclicGenerator d g hg
  letI : IsCyclic (Gal(E/D)) := CyclicCohomology.isCyclic_of_generator g' hg'
  letI : CommGroup Q := IsCyclic.commGroup
  letI : CommGroup (Gal(E/D)) := IsCyclic.commGroup
  have co:=ClassFieldAxiom.tate_lowDegree_from_idele_classes data D E g' hg'
  let e0:=TateCohomology.isoFiniteCyclicZero M g hg ≪≫
    normHomCompSubHomologyIsoOfRepIso eInv.symm g ≪≫ normHomCompSubHomologyResEquivIso d U g ≪≫
    (TateCohomology.isoFiniteCyclicZero U g' hg').symm
  let em:=TateCohomology.isoFiniteCyclicNegOne M g hg ≪≫
    subCompNormHomHomologyIsoOfRepIso eInv.symm g ≪≫ subCompNormHomHomologyResEquivIso d U g ≪≫
    (TateCohomology.isoFiniteCyclicNegOne U g' hg').symm
  refine ⟨(Nat.card_congr e0.toLinearEquiv.toEquiv).trans (co.2.2.1.trans ?_),?_⟩
  · exact (IsGalois.card_aut_eq_finrank D E).symm.trans (Nat.card_congr d.symm.toEquiv)
  · exact (Nat.card_eq_one_iff_unique.mp ((Nat.card_congr em.toLinearEquiv.toEquiv).trans co.2.2.2)).1
end
end TunnellTensorTateEquivalence
end
/- TunnellTensorTateFixedFields -/
section
namespace TunnellTensorTateFixedFields
open RamificationTheory NumberField CyclicCohomology ClassFormation LocalClassFieldTheory KummerTheory
open scoped NumberField Classical IsMulCommutative
noncomputable section
abbrev Ω := SeparableClosure ℚ
abbrev G := Gal(Ω/ℚ)
theorem descend (X : Rep.{0} ℤ G) (data : TunnellGlobalFormationModel.CyclicClasses)
    (present : ∀ (D E : Type) [Field D] [NumberField D] [Field E] [NumberField E]
      [Algebra D E] [FiniteDimensional D E] (e : E →ₐ[ℚ] Ω),
      ∃ f : RelativeIdeleGroup D E →* Multiplicative (ambientFixedAddSubgroup X (closedFixingSubgroup ℚ Ω e.fieldRange)),
        Function.Surjective f ∧ f.ker = RelativeIdeleGroup.principalSubgroup D E ∧
        ∀ (g : G) (τ : Gal(E/D)), (∀ x : E, g (e x) = e (τ x)) →
          ∀ x, X.ρ g (f x).toAdd.val = (f (RelativeIdeleGroup.conjugationIdele D E τ x)).toAdd.val) :
    TunnellAbstractNormCoordinates.Tate X := by
  intro H J _ h normal _ _
  let Q := H.toSubgroup ⧸ extensionSubgroup H J h
  let D := abstractFixedField ℚ Ω H
  let E := abstractRelativeFixedField ℚ Ω h
  have hf := (TunnellAbstractNormCoordinates.finiteField H).finite
  letI : FiniteDimensional ℚ D := abstractFixedField_finiteDimensional ℚ Ω H hf
  letI : FiniteDimensional D E := abstractRelativeFixedField_finiteDimensional ℚ Ω H J h hf inferInstance
  letI : IsScalarTower ℚ D E := IsScalarTower.of_algebraMap_eq' rfl
  letI : FiniteDimensional ℚ E := FiniteDimensional.trans ℚ D E
  letI : NumberField D := NumberField.of_module_finite ℚ D
  letI : NumberField E := NumberField.of_module_finite ℚ E
  letI : IsGalois D E := abstractRelativeFixedField_isGalois ℚ Ω H J h normal
  let d : Q ≃* Gal(E/D) := abstractExtensionQuotientEquivGaloisGroup ℚ Ω H J h normal
  let M := extensionFixedRepresentation X H J h normal
  let e : E →ₐ[ℚ] Ω := (abstractFixedField ℚ Ω J).val
  have he : closedFixingSubgroup ℚ Ω e.fieldRange = J := by
    rw [show e.fieldRange = abstractFixedField ℚ Ω J from IntermediateField.fieldRange_val _]
    exact closedFixingSubgroup_abstractFixedField_eq ℚ Ω J
  obtain ⟨f,sf,hk,act⟩ := present D E e
  let c : ambientFixedAddSubgroup X (closedFixingSubgroup ℚ Ω e.fieldRange) ≃+ M.V :=
    (AddEquiv.addSubgroupCongr (congrArg (ambientFixedAddSubgroup X) he)).trans
      (extensionFixedRepresentationEquiv X H J h normal).symm
  let b := c.toMultiplicative
  refine TunnellTensorTateEquivalence.result D E Q d M data (b.toMonoidHom.comp f)
    (b.surjective.comp sf) ((MonoidHom.ker_comp_of_injective f b.toMonoidHom b.injective).trans hk) ?_
  intro q z
  obtain ⟨g,rfl⟩ := QuotientGroup.mk'_surjective (extensionSubgroup H J h) q
  apply Subtype.ext
  change X.ρ g.val (f z).toAdd.val = (f (RelativeIdeleGroup.conjugationIdele D E (d _) z)).toAdd.val
  apply act
  exact abstractExtensionQuotientEquivGaloisGroup_mk_apply_val ℚ Ω H J h normal g
end
end TunnellTensorTateFixedFields
end
/- TunnellTensorTateReceiver -/
section
namespace TunnellTensorTateReceiver
open NumberField TunnellTensorProjectiveClass TunnellTensorScalarTransport
open scoped NumberField Classical
noncomputable section
theorem actual (s : Scalar) (data : TunnellGlobalFormationModel.CyclicClasses) :
    TunnellAbstractNormCoordinates.Tate (A ℚ R Ω) := by
  apply TunnellTensorTateFixedFields.descend _ data
  intro D E _ _ _ _ _ _ e
  exact ⟨upper s D E e,upper_surj s D E e,upper_ker s D E e,
    TunnellTensorTateAction.upper_act s D E e⟩
end
end TunnellTensorTateReceiver
end

