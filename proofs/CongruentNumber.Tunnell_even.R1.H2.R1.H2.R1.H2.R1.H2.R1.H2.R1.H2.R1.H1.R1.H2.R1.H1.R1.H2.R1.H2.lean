/- TunnellGlobalFormationModel -/
section
namespace TunnellGlobalFormationModel
open NumberField
open scoped NumberField TensorProduct Classical
def CyclicClasses : Prop :=
  ∀(D N:Type)[Field D][NumberField D][Field N][NumberField N][Algebra D N]
   [FiniteDimensional D N][IsGalois D N](g:Gal(N/D)),(∀ s,s∈Subgroup.zpowers g) →
   let A:=AdeleRing (𝓞 D) D
   let T:=A⊗[D]N
   let P:=(Units.map (algebraMap D A).toMonoidHom).range ⊔ (Units.map (Algebra.norm A (S:=T))).range
   let q:=QuotientGroup.mk' (Units.map (Algebra.TensorProduct.includeRight (R:=D) (A:=A) (B:=N)).toMonoidHom).range
   let a(s:Gal(N/D)):=Units.mapEquiv (Algebra.TensorProduct.congr (AlgEquiv.refl (R:=A) (A₁:=A)) s).toMulEquiv
   P.index=Module.finrank D N ∧ ∀ z:Tˣ,(∏ s:Gal(N/D),q (a s z))=1 → ∃ y:Tˣ,q (a g y / y)=q z
end TunnellGlobalFormationModel
end
/- TunnellGlobalClassModel -/
section
namespace TunnellGlobalClassModel
open NumberField
open scoped NumberField TensorProduct Classical
def Realization : Prop :=
  TunnellGlobalFormationModel.CyclicClasses →
  let Ω:=SeparableClosure ℚ
  let G:=Gal(Ω/ℚ)
  ∀ [IsGalois ℚ Ω], ∃ A:Rep ℤ G, letI : Module ℤ A.V:=A.hV2
    let S:=ClosedSubgroup G
    let U:=fun H:S => H.toSubgroup
    let M:=fun H J:S => (U J).subgroupOf (U H)
    let B:=fun H:S => (Representation.invariants (A.ρ.comp (U H).subtype)).toAddSubgroup
    let N:=fun (H J:S) (a:A.V) => ∃ b:B J, ∑ᶠ q:U H ⧸ M H J, A.ρ q.out.val b.val=a
    (∀(H J:S)[(U H).FiniteIndex], J≤H → ∀[(M H J).Normal][Fintype (U H ⧸ M H J)][IsCyclic (U H ⧸ M H J)],
      let C:=(Rep.res (U H).subtype A).quotientToInvariants (M H J)
      Nat.card (tateCohomology C 0)=Nat.card (U H ⧸ M H J) ∧ Subsingleton (tateCohomology C (-1))) ∧
    ∀ (D:Type)[Field D][NumberField D](j:D →ₐ[ℚ] Ω),
      let R:=AdeleRing (𝓞 D) D
      let H:S:=⟨j.fieldRange.fixingSubgroup,InfiniteGalois.fixingSubgroup_isClosed _⟩
      let P:=(Units.map (algebraMap D R).toMonoidHom).range
      ∃ i:Rˣ →* Multiplicative (B H), Function.Surjective i ∧ i.ker=P ∧
        ∀ (F:Type)[Field F][NumberField F][Algebra D F][FiniteDimensional D F](e:F →ₐ[ℚ] Ω),
          (∀ x:D,e (algebraMap D F x)=j x) → ∀ z:Rˣ,
          N H ⟨e.fieldRange.fixingSubgroup,InfiniteGalois.fixingSubgroup_isClosed _⟩ (i z).toAdd.val ↔
            z∈P ⊔ (Units.map (Algebra.norm R (S:=R⊗[D]F))).range
end TunnellGlobalClassModel
end
/- TunnellGlobalFormationBridge -/
section
namespace TunnellGlobalFormationBridge
open NumberField IsDedekindDomain TunnellAdelicIndexData
open CyclicCohomology CyclicCohomology.ProfiniteCohomology.Herbrand
open RelativeIdeleGroup.Cohomology
open scoped NumberField TensorProduct Classical IsMulCommutative
noncomputable section
variable (D N : Type) [Field D] [NumberField D] [Field N] [NumberField N] [Algebra D N]
  [FiniteDimensional D N] [IsGalois D N]
abbrev G := Gal(N/D)
abbrev I := RelativeIdeleGroup D N
abbrev C := RelativeIdeleGroup.ClassGroup D N
abbrev q := QuotientGroup.mk' (RelativeIdeleGroup.principalSubgroup D N)
local instance : MulDistribMulAction (G D N) (C D N) := ideleClassMulDistribMulAction D N
theorem lower_degree :
    Nat.card (HerbrandH0 (G D N) (C D N)) = (P D N).index := by
  rw [← RelativeIdeleGroup.Cohomology.ideleClassNorm_index_eq_herbrandH0_card D N,
    ← TunnellCyclicAdelicIndex.presentation D N,
    Subgroup.index_comap_of_surjective _ (TunnellCyclicAdelicIndex.cls_surjective D)]
abbrev action (s : G D N) := RelativeIdeleGroup.conjugationIdele D N s
abbrev coboundary (g : G D N) :=
  ∀ z : I D N, (∏ s : G D N, q D N (action D N s z))=1 →
    ∃ y : I D N, q D N (action D N g y / y)=q D N z
theorem coboundary_iff (g : G D N) : coboundary D N g ↔
    Nat.card (HerbrandHMinusOne (G D N) (C D N) g)=1 := by
  constructor
  · intro h
    apply Nat.card_eq_one_iff_exists.mpr
    refine ⟨1,?_⟩
    intro a
    obtain ⟨⟨c,hc⟩,rfl⟩ := HerbrandHMinusOne.mk_surjective (G:=G D N) (A:=C D N) g a
    obtain ⟨z,rfl⟩ := QuotientGroup.mk'_surjective (RelativeIdeleGroup.principalSubgroup D N) c
    obtain ⟨y,hy⟩ := h z hc
    apply (HerbrandHMinusOne.mk_eq_one_iff g _).mpr
    refine ⟨q D N y,?_⟩
    change q D N (action D N g y) * (q D N y)⁻¹ = q D N z
    exact (div_eq_mul_inv _ _).symm.trans ((map_div (q D N) _ _).symm.trans hy)
  · intro h z hz
    let c : normKernelSubgroup (G D N) (C D N) := ⟨q D N z,hz⟩
    haveI := (Nat.card_eq_one_iff_unique.mp h).1
    have hzero : HerbrandHMinusOne.mk g c = 1 := Subsingleton.elim _ _
    obtain ⟨b,hb⟩ := (HerbrandHMinusOne.mk_eq_one_iff g c).mp hzero
    obtain ⟨y,rfl⟩ := QuotientGroup.mk'_surjective (RelativeIdeleGroup.principalSubgroup D N) b
    change q D N (action D N g y) * (q D N y)⁻¹ = q D N z at hb
    exact ⟨y, (map_div (q D N) _ _).trans ((div_eq_mul_inv _ _).trans hb)⟩
theorem herbrand (h : TunnellGlobalFormationModel.CyclicClasses) (g : G D N)
    (hg : ∀ s,s∈Subgroup.zpowers g) :
    Nat.card (HerbrandH0 (G D N) (C D N))=Module.finrank D N ∧
    Nat.card (HerbrandHMinusOne (G D N) (C D N) g)=1 := by
  obtain ⟨hi,hc⟩ := h D N g hg
  exact ⟨(lower_degree D N).trans hi,(coboundary_iff D N g).mp hc⟩
end
end TunnellGlobalFormationBridge
end
/- TunnellGlobalFormationOfNorms -/
section
namespace GlobalClassFieldTheory.ClassFieldAxiom
open CyclicCohomology CyclicCohomology.ProfiniteCohomology.Herbrand
noncomputable section
theorem tate_lowDegree_from_idele_classes (data : TunnellGlobalFormationModel.CyclicClasses)
    (K L : Type)
    [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L]
    (sigma : L ≃ₐ[K] L)
    (hsigma :
      ∀ tau : L ≃ₐ[K] L,
        tau ∈ Subgroup.zpowers sigma) :
    letI :=
      RelativeIdeleGroup.Cohomology.ideleClassMulDistribMulAction K L
    Finite
          (tateCohomology
            (Rep.ofMulDistribMulAction (L ≃ₐ[K] L)
              (RelativeIdeleGroup.ClassGroup K L)) 0) ∧
      Finite
          (tateCohomology
            (Rep.ofMulDistribMulAction (L ≃ₐ[K] L)
              (RelativeIdeleGroup.ClassGroup K L)) (-1)) ∧
      Nat.card
          (tateCohomology
            (Rep.ofMulDistribMulAction (L ≃ₐ[K] L)
              (RelativeIdeleGroup.ClassGroup K L)) 0) =
        Module.finrank K L ∧
      Nat.card
          (tateCohomology
            (Rep.ofMulDistribMulAction (L ≃ₐ[K] L)
              (RelativeIdeleGroup.ClassGroup K L)) (-1)) =
        1 := by
  let :=
    RelativeIdeleGroup.Cohomology.ideleClassMulDistribMulAction K L
  have hHerbrand :=
    TunnellGlobalFormationBridge.herbrand K L data sigma hsigma
  let :
      Finite
        (HerbrandH0 (L ≃ₐ[K] L)
          (RelativeIdeleGroup.ClassGroup K L)) :=
    Nat.finite_of_card_ne_zero (by
      rw [hHerbrand.1]
      exact Nat.ne_of_gt Module.finrank_pos)
  let :
      Finite
        (HerbrandHMinusOne (L ≃ₐ[K] L)
          (RelativeIdeleGroup.ClassGroup K L) sigma) :=
    Nat.finite_of_card_ne_zero (by
      rw [hHerbrand.2]
      exact one_ne_zero)
  let e0 :
      tateCohomology
          (Rep.ofMulDistribMulAction (L ≃ₐ[K] L)
            (RelativeIdeleGroup.ClassGroup K L)) 0 ≃
        Additive
          (HerbrandH0 (L ≃ₐ[K] L)
            (RelativeIdeleGroup.ClassGroup K L)) :=
    (tateH0IsoHerbrandH0
      (G := L ≃ₐ[K] L)
      (A := RelativeIdeleGroup.ClassGroup K L)).toLinearEquiv.toEquiv
  let em :
      tateCohomology
          (Rep.ofMulDistribMulAction (L ≃ₐ[K] L)
            (RelativeIdeleGroup.ClassGroup K L)) (-1) ≃
        Additive
          (HerbrandHMinusOne (L ≃ₐ[K] L)
            (RelativeIdeleGroup.ClassGroup K L) sigma) :=
    (tateHMinusOneIsoHerbrandHMinusOne
      (G := L ≃ₐ[K] L)
      (A := RelativeIdeleGroup.ClassGroup K L)
      sigma hsigma).toLinearEquiv.toEquiv
  let :
      Finite
        (tateCohomology
          (Rep.ofMulDistribMulAction (L ≃ₐ[K] L)
            (RelativeIdeleGroup.ClassGroup K L)) 0) :=
    Finite.of_injective e0 e0.injective
  let :
      Finite
        (tateCohomology
          (Rep.ofMulDistribMulAction (L ≃ₐ[K] L)
            (RelativeIdeleGroup.ClassGroup K L)) (-1)) :=
    Finite.of_injective em em.injective
  refine ⟨inferInstance, inferInstance, ?_, ?_⟩
  · calc
      Nat.card
            (tateCohomology
              (Rep.ofMulDistribMulAction (L ≃ₐ[K] L)
                (RelativeIdeleGroup.ClassGroup K L)) 0) =
          Nat.card
            (Additive
              (HerbrandH0 (L ≃ₐ[K] L)
                (RelativeIdeleGroup.ClassGroup K L))) :=
        Nat.card_congr e0
      _ = Module.finrank K L := by
        change
          Nat.card
              (HerbrandH0 (L ≃ₐ[K] L)
                (RelativeIdeleGroup.ClassGroup K L)) =
            Module.finrank K L
        exact hHerbrand.1
  · calc
      Nat.card
            (tateCohomology
              (Rep.ofMulDistribMulAction (L ≃ₐ[K] L)
                (RelativeIdeleGroup.ClassGroup K L)) (-1)) =
          Nat.card
            (Additive
              (HerbrandHMinusOne (L ≃ₐ[K] L)
                (RelativeIdeleGroup.ClassGroup K L) sigma)) :=
        Nat.card_congr em
      _ = 1 := by
        change
          Nat.card
              (HerbrandHMinusOne (L ≃ₐ[K] L)
                (RelativeIdeleGroup.ClassGroup K L) sigma) =
            1
        exact hHerbrand.2
end
end GlobalClassFieldTheory.ClassFieldAxiom
